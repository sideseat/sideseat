# One place that says how files are shaped, so an editor does not have to guess and a diff does not
# carry someone's tab width. Matches the formatters already in the repo: rustfmt (4 spaces),
# prettier (2 spaces), ruff (4 spaces).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4
max_line_length = 100

[*.{py,pyi}]
indent_size = 4

[*.{md,mdx}]
# Trailing whitespace is significant in Markdown line breaks.
trim_trailing_whitespace = false

[*.{tla,cfg}]
indent_size = 4

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
