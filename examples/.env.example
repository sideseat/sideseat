# =============================================================================
# SideSeat Telemetry Samples - Environment Configuration
# =============================================================================
# Copy to .env and fill in your values

# -----------------------------------------------------------------------------
# OpenTelemetry Configuration (all frameworks)
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:5388/otel/default
OTEL_SERVICE_NAME=telemetry-sample
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# Credentials, needed only when the server is *not* started with `--no-auth`.
# `auth.enabled` defaults to true, so a plain `sideseat` needs these; the
# documented dev server (`make dev-server ARGS="--no-auth"`) needs neither.
#
# Two variables, because the samples take two different export paths:
#
#   SIDESEAT_API_KEY      read by the SideSeat SDK (`--sideseat` runs). It
#                         authenticates both OTLP export and the WebSocket
#                         runtime channel used by `strands_ws`, which registers
#                         and invokes agents - without it that sample
#                         reconnect-loops on 401 against a healthy server.
#   OTEL_EXPORTER_OTLP_HEADERS
#                         read by the *native* framework exporters (runs without
#                         `--sideseat`, e.g. StrandsTelemetry). They know nothing
#                         about SIDESEAT_API_KEY, so with
#                         `otel.auth.required=true` they need the standard OTLP
#                         header variable instead.
# SIDESEAT_API_KEY=sk_...
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20sk_...

# -----------------------------------------------------------------------------
# AWS Credentials (for Strands, LangGraph, and CrewAI using Bedrock)
# -----------------------------------------------------------------------------
# Both are needed: the JavaScript AWS SDK reads AWS_REGION, while botocore (every Python
# suite) reads AWS_DEFAULT_REGION and ignores AWS_REGION entirely - setting only the
# latter leaves the Python samples on whatever region ~/.aws/config specifies.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=

# AWS AgentCore (for agent_core sample)
# Create a memory store and strategy in AWS Bedrock AgentCore console
# Find via: boto3 bedrock-agentcore-control client list_memories / get_memory
AGENT_CORE_MEMORY_ID=
AGENT_CORE_MEMORY_STRATEGY_ID=
S3_BUCKET_NAME=
# Bedrock image model for the image_gen samples. Defaults to
# stability.sd3-5-large-v1:0, which is currently only offered on-demand in a subset of
# regions (us-west-2 among them) - set AWS_REGION accordingly or the call returns
# ValidationException. amazon.titan-image-generator-v2:0 has been retired.
IMAGE_GEN_MODEL=
# -----------------------------------------------------------------------------
# Anthropic API
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Google API 
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# OpenAI API 
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Cohere API
# -----------------------------------------------------------------------------
COHERE_API_KEY=

# -----------------------------------------------------------------------------
# Mistral API
# -----------------------------------------------------------------------------
MISTRAL_API_KEY=

# -----------------------------------------------------------------------------
# XAI API
# -----------------------------------------------------------------------------
XAI_API_KEY=

# -----------------------------------------------------------------------------
# DeepSeek API
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=