{
  "name": "sideseat-javascript-examples",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "sample": "tsx harness/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.105",
    "@ai-sdk/otel": "^1.0.127",
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@sideseat/sdk": "file:../../sdk/js",
    "@smithy/node-http-handler": "^4.12.1",
    "@strands-agents/sdk": "^1.19.0",
    "ai": "^7.0.127",
    "dotenv": "^18.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "//opentelemetry": "exporter-trace-otlp-http is held at 0.219 because @strands-agents/sdk 1.19 still declares peerOptional ^0.219.0, and 0.x minors are breaking under semver so 0.222 does not satisfy it. sdk/js itself is on 0.222; npm nests the two. Revisit when Strands widens that peer range.",
  "//typescript": "Held at 5.x to match sdk/js: typescript-eslint 8.71 supports TypeScript >=4.8.4 <6.1.0, so TypeScript 7 would leave the lint toolchain outside its supported peer range."
}
