#!/usr/bin/env bash
#
# Cheap by design: a commit must never wait for a test suite. This hook stops the two mistakes that
# are expensive to undo once committed - a secret, and an oversized file - and checks formatting.
# Lint and tests run in `make quick` while iterating and in the pre-push hook.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# A committed secret survives in reflogs, stashes, and clones even if it is never pushed.
make --no-print-directory secret-scan-staged
# Reads blobs from the index, so an unstaged shortening cannot hide an oversized staged version.
./scripts/check/file-lengths.sh --cached

staged() { git diff --cached --name-only --diff-filter=ACMR -- "$@"; }

# A staged file identical to one of its own earlier versions undoes every commit to it since: in a shared tree that
# is almost always a working copy saved before someone else's commit landed, which a whole-file commit then puts
# back without a word. A deliberate restore says so with SIDESEAT_ALLOW_RESTORE=1.
if [ "${SIDESEAT_ALLOW_RESTORE:-}" != 1 ] && git rev-parse -q --verify HEAD >/dev/null; then
    restored=()
    while IFS= read -r file; do
        [ -n "$file" ] || continue
        blob="$(git rev-parse ":$file")"
        [ "$blob" != "$(git rev-parse -q --verify "HEAD:$file" 2>/dev/null || true)" ] || continue
        while IFS= read -r commit; do
            if [ "$(git rev-parse -q --verify "$commit:$file" 2>/dev/null || true)" = "$blob" ]; then
                restored+=("$file (its content at $(git rev-parse --short "$commit"))")
                break
            fi
        done < <(git log --format=%H -n 30 HEAD -- "$file" | tail -n +2)
    done < <(git diff --cached --name-only --diff-filter=M)
    if [ ${#restored[@]} -gt 0 ]; then
        echo "[pre-commit] these files would go back to an earlier version, undoing later commits to them:" >&2
        printf '  %s\n' "${restored[@]}" >&2
        echo "[pre-commit] rebase the working copy onto HEAD; a deliberate restore sets SIDESEAT_ALLOW_RESTORE=1" >&2
        exit 1
    fi
fi

# Formatting is checked on the staged blobs, not the working copies: in a shared tree a commit built from a
# private index can stage one agent's hunks of a file that also holds another agent's unformatted work in
# progress, and the working copy says nothing about what is committed. Each blob is piped through its formatter
# and compared with itself (`rustfmt --check` exits 0 on stdin whatever it finds, so the comparison is the check).
unformatted=()
formats_unchanged() {
    local path="$1"
    shift
    cmp -s <(git show ":$path") <(git show ":$path" | "$@" 2>/dev/null)
}

# Files under `*_rule_cases/` are expression fragments `include!`d into a test, which rustfmt cannot parse alone.
while IFS= read -r file; do
    [ -n "$file" ] || continue
    formats_unchanged "$file" rustfmt --edition 2024 --emit stdout || unformatted+=("$file")
done < <(staged '*.rs' | grep -v '_rule_cases/' || true)

while IFS= read -r file; do
    [ -n "$file" ] || continue
    formats_unchanged "$file" uv run --locked ruff format --stdin-filename "$file" || unformatted+=("$file")
done < <(staged '*.py')

for project in web sdk/js examples/javascript; do
    files="$(staged "$project/*.ts" "$project/*.tsx" "$project/*.css" "$project/*.json")"
    [ -n "$files" ] || continue
    [ -x "$project/node_modules/.bin/prettier" ] || { echo "Error: $project/node_modules missing. Run 'make setup'."; exit 1; }
    # The project's .prettierignore applies through --stdin-filepath: generated JSON such as capture cassettes
    # is passed through unchanged.
    while IFS= read -r file; do
        [ -n "$file" ] || continue
        formats_unchanged "$file" "$project/node_modules/.bin/prettier" \
            --ignore-path "$project/.prettierignore" --stdin-filepath "$file" || unformatted+=("$file")
    done <<<"$files"
done

if [ ${#unformatted[@]} -gt 0 ]; then
    echo "[pre-commit] staged content is not formatted:" >&2
    printf '  %s\n' "${unformatted[@]}" >&2
    exit 1
fi

echo "[pre-commit] Passed"
