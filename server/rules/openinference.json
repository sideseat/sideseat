{
  "id": "openinference",
  "doc": "The OpenInference dialect. Its messages arrive as *indexed attribute families* - a list of objects flattened into dotted keys, because OTel attributes are a flat map - and its retrieval spans report documents the same way. The one thing that is not a plain read is the multimodal overlay: the dotted keys lose file blocks and redact URLs, while a serialised `input.value` on the same span holds the whole content, so the richer copy is joined on by position.",
  "carriers": [
    {
      "id": "openinference.output_messages",
      "doc": "What this span produced, as an indexed array.",
      "match": {
        "attribute_prefix": "llm.output_messages"
      },
      "facts": {
        "preset": "emission"
      }
    },
    {
      "id": "openinference.input_messages",
      "doc": "The conversation this span received, as an indexed array. Its members are separate attribute keys that are one array, so they carry an ordering family: `llm.input_messages.0.message` and `.1.message` are one sequence, and the order resolver needs to know that to sequence a request's own new turns. That fact used to be a hardcoded key comparison in the resolver, which is precisely the shape of framework knowledge this engine exists to hold instead.",
      "match": {
        "attribute_prefix": "llm.input_messages"
      },
      "facts": {
        "preset": "snapshot",
        "carrier_holds_span_input": true
      },
      "ordering_family": "openinference.input_messages"
    }
  ],
  "detect": [
    {
      "id": "openinference.detect",
      "doc": "The generic OpenInference dialect, after every framework that rides on it.",
      "label": "OpenInference",
      "match": {
        "attr_prefix": [
          "openinference."
        ]
      },
      "legacy_rank": 140
    }
  ],
  "messages": [
    {
      "id": "openinference.input_messages",
      "doc": "The conversation the span received.",
      "read": {
        "indexed_family": "llm.input_messages",
        "entry_member": "message",
        "overlay": {
          "doc": "The flattened family loses whole content blocks and writes `__REDACTED__` for a url, while this dialect's serialised copy of the same conversation keeps both - so where both describe one message, the richer one is preferred. Matched by position, and only for an entry whose content arrived flattened.",
          "from": "input.value",
          "parse": "json",
          "select_any_of": [
            "$.messages",
            "$"
          ],
          "witness": {
            "any": [
              {
                "path": "$[*].id",
                "kind": "array",
                "doc": "This dialect writes a message class path as an array. Asked of every member, not the first: a list may open with a shape that omits it."
              },
              {
                "path": "$[?@.lc]",
                "exists": true
              },
              {
                "path": "$[?@.kwargs]",
                "exists": true
              }
            ]
          },
          "when_member_prefix": "contents.",
          "content_any_of": [
            "$.content",
            "$.kwargs.content",
            "$.text"
          ],
          "require": {
            "all": [
              {
                "kind": "array"
              }
            ]
          },
          "as_member": "content",
          "unwrap_single_element_list": true
        }
      },
      "require_members": {
        "all_of": [
          {
            "name": "role"
          }
        ],
        "any_of": [
          {
            "name": "content"
          },
          {
            "name": "contents",
            "presence": "nested"
          },
          {
            "name": "tool_calls",
            "presence": "nested"
          },
          {
            "name": "tool_call_id"
          },
          {
            "name": "function_call",
            "presence": "nested"
          }
        ]
      },
      "legacy_rank": 200
    },
    {
      "id": "openinference.output_messages",
      "doc": "What the span produced.",
      "read": {
        "indexed_family": "llm.output_messages",
        "entry_member": "message"
      },
      "require_members": {
        "all_of": [
          {
            "name": "role"
          }
        ],
        "any_of": [
          {
            "name": "content"
          },
          {
            "name": "contents",
            "presence": "nested"
          },
          {
            "name": "tool_calls",
            "presence": "nested"
          },
          {
            "name": "tool_call_id"
          },
          {
            "name": "function_call",
            "presence": "nested"
          }
        ]
      },
      "legacy_rank": 210
    },
    {
      "id": "openinference.retrieval",
      "doc": "What a retrieval returned. One message holding every document, not one each: they are a result set, and splitting them would read as a conversation.",
      "read": {
        "indexed_family": "retrieval.documents",
        "entry_member": "document",
        "numeric_members": [
          "score"
        ]
      },
      "require_members": {
        "any_of": [
          {
            "name": "id"
          },
          {
            "name": "content"
          },
          {
            "name": "score"
          },
          {
            "name": "metadata"
          }
        ]
      },
      "aggregate_into_array": true,
      "tag_as": "retrieval.documents",
      "wrap": {
        "role": "documents",
        "members": {
          "_source": "retrieval.documents"
        }
      },
      "legacy_rank": 220
    },
    {
      "id": "openinference.reranker_input",
      "doc": "The documents a reranker was given.",
      "read": {
        "indexed_family": "reranker.input_documents",
        "entry_member": "document",
        "numeric_members": [
          "score"
        ]
      },
      "require_members": {
        "any_of": [
          {
            "name": "id"
          },
          {
            "name": "content"
          },
          {
            "name": "score"
          },
          {
            "name": "metadata"
          }
        ]
      },
      "aggregate_into_array": true,
      "tag_as": "reranker.input_documents",
      "wrap": {
        "role": "documents",
        "members": {
          "_source": "reranker.input_documents"
        }
      },
      "legacy_rank": 230
    },
    {
      "id": "openinference.reranker_output",
      "doc": "The order it put them in.",
      "read": {
        "indexed_family": "reranker.output_documents",
        "entry_member": "document",
        "numeric_members": [
          "score"
        ]
      },
      "require_members": {
        "any_of": [
          {
            "name": "id"
          },
          {
            "name": "content"
          },
          {
            "name": "score"
          },
          {
            "name": "metadata"
          }
        ]
      },
      "aggregate_into_array": true,
      "tag_as": "reranker.output_documents",
      "wrap": {
        "role": "documents",
        "members": {
          "_source": "reranker.output_documents"
        }
      },
      "legacy_rank": 240
    },
    {
      "id": "openinference.reranker_query",
      "doc": "The query a reranker scored against.",
      "read": {
        "attribute": "reranker.query"
      },
      "parse": "text",
      "wrap": {
        "role": "user",
        "members": {
          "_source": "reranker.query"
        }
      },
      "legacy_rank": 250
    },
    {
      "id": "openinference.embedding_text",
      "doc": "The text an embedding span turned into a vector.",
      "read": {
        "attribute": "embedding.text"
      },
      "parse": "text",
      "wrap": {
        "role": "user",
        "members": {
          "_source": "embedding.text"
        }
      },
      "legacy_rank": 260
    },
    {
      "id": "openinference.tools",
      "doc": "This dialect's tool schemas, in one attribute, elements possibly serialised.",
      "read": {
        "attribute": "llm.tools"
      },
      "parse": "stringified_array",
      "emit": "tool_definitions",
      "legacy_rank": 270
    },
    {
      "id": "openinference.single_tool",
      "doc": "One tool per span, written as three separate attributes. Yielded to two things, each stated rather than left to evaluation order: this dialect's own *list* carriers, which describe the same tools, and the **convention's** single-tool attributes, which take precedence over a dialect's spelling of the same fact. The retired code expressed both as one global \"has anything produced tools yet\" flag - which any unrelated dialect could satisfy first, and which said nothing about why.",
      "unless": {
        "attr_exists": [
          "llm.tools",
          "gen_ai.tool.name"
        ],
        "attr_prefix": [
          "llm.tools."
        ]
      },
      "compose": {
        "tag": "tool.name",
        "as_tool_definition": true,
        "members": [
          {
            "as": "name",
            "from_any_of": [
              "tool.name"
            ],
            "parse": "text"
          },
          {
            "as": "description",
            "from_any_of": [
              "tool.description"
            ],
            "parse": "text"
          },
          {
            "as": "parameters",
            "from_any_of": [
              "tool.parameters"
            ],
            "parse": "json"
          }
        ]
      },
      "emit": "tool_definitions",
      "legacy_rank": 280
    },
    {
      "id": "openinference.indexed_tools",
      "doc": "Tool schemas as an indexed family, one JSON schema per entry. The entry is a wrapper around that schema, so the projection names the leaf that is the datum - an entry without one is not this shape and contributes nothing. Aggregated because a tool list is one observation, not one per tool.",
      "read": {
        "indexed_family": "llm.tools",
        "entry_value": "$['tool.json_schema']"
      },
      "emit": "tool_definitions",
      "aggregate_into_array": true,
      "tag_as": "llm.tools.N.tool.json_schema",
      "legacy_rank": 260
    },
    {
      "id": "openinference.indexed_tool_names",
      "doc": "The same family's names, projected from each schema's function definition. A separate rule because a name list and a definition list are different observations - one says which tools were available, the other what they take.",
      "read": {
        "indexed_family": "llm.tools",
        "entry_value": "$['tool.json_schema'].function.name"
      },
      "emit": "tool_names",
      "aggregate_into_array": true,
      "tag_as": "llm.tools.N.tool.json_schema",
      "legacy_rank": 265
    }
  ],
  "span_facts": [
    {
      "id": "openinference.tool_execution",
      "doc": "This dialect states a span's kind directly, in capitals.",
      "fact": "tool_execution",
      "signals": [
        {
          "attr_equals": {
            "key": "openinference.span.kind",
            "value": "tool"
          },
          "ignore_case": true
        }
      ]
    }
  ]
}
