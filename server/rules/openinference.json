{
  "id": "openinference",
  "doc": "The OpenInference dialect. Its messages arrive as *indexed attribute families* - a list of objects flattened into dotted keys, because OTel attributes are a flat map - and its retrieval spans report documents the same way. The one thing that is not a plain read is the multimodal overlay: the dotted keys lose file blocks and redact URLs, while a serialised `input.value` on the same span holds the whole content, so the richer copy is joined on by position.",
  "carriers": [
    {
      "id": "openinference.output_messages",
      "doc": "What this span produced, as an indexed array.",
      "match": {
        "attribute_prefix": "llm.output_messages"
      },
      "facts": {
        "preset": "emission"
      }
    },
    {
      "id": "openinference.input_messages",
      "doc": "The conversation this span received, as an indexed array. Its members are separate attribute keys that are one array, so they carry an ordering family: `llm.input_messages.0.message` and `.1.message` are one sequence, and the order resolver needs to know that to sequence a request's own new turns. That fact used to be a hardcoded key comparison in the resolver, which is precisely the shape of framework knowledge this engine exists to hold instead.",
      "match": {
        "attribute_prefix": "llm.input_messages"
      },
      "facts": {
        "preset": "snapshot"
      },
      "ordering_family": "openinference.input_messages"
    }
  ],
  "detect": [
    {
      "id": "openinference.detect",
      "doc": "The generic OpenInference dialect, after every framework that rides on it.",
      "label": "OpenInference",
      "match": {
        "attr_prefix": [
          "openinference."
        ]
      },
      "legacy_rank": 140
    }
  ],
  "messages": [
    {
      "id": "openinference.input_messages",
      "doc": "The conversation the span received.",
      "read": {
        "indexed_family": "llm.input_messages",
        "entry_member": "message",
        "overlay": {
          "doc": "The flattened family loses whole content blocks and writes `__REDACTED__` for a url, while this dialect's serialised copy of the same conversation keeps both - so where both describe one message, the richer one is preferred. Matched by position, and only for an entry whose content arrived flattened.",
          "from": "input.value",
          "parse": "json",
          "select_any_of": [
            "$.messages[0]",
            "$.messages",
            "$"
          ],
          "witness": {
            "any": [
              {
                "path": "$[?count(@.id[*]) > 0]",
                "exists": true
              },
              {
                "path": "$[?@.lc]",
                "exists": true
              },
              {
                "path": "$[?@.kwargs]",
                "exists": true
              }
            ]
          },
          "when_member_prefix": "contents.",
          "content_any_of": [
            "$.content",
            "$.kwargs.content",
            "$.text"
          ],
          "require": {
            "all": [
              {
                "kind": "array"
              }
            ]
          },
          "as_member": "content"
        }
      },
      "require_members": {
        "all_of": [
          {
            "name": "role"
          }
        ],
        "any_of": [
          {
            "name": "content"
          },
          {
            "name": "contents",
            "presence": "nested"
          },
          {
            "name": "tool_calls",
            "presence": "nested"
          },
          {
            "name": "tool_call_id"
          },
          {
            "name": "function_call",
            "presence": "nested"
          }
        ]
      },
      "legacy_rank": 200
    },
    {
      "id": "openinference.output_messages",
      "doc": "What the span produced.",
      "read": {
        "indexed_family": "llm.output_messages",
        "entry_member": "message"
      },
      "require_members": {
        "all_of": [
          {
            "name": "role"
          }
        ],
        "any_of": [
          {
            "name": "content"
          },
          {
            "name": "contents",
            "presence": "nested"
          },
          {
            "name": "tool_calls",
            "presence": "nested"
          },
          {
            "name": "tool_call_id"
          },
          {
            "name": "function_call",
            "presence": "nested"
          }
        ]
      },
      "legacy_rank": 210
    },
    {
      "id": "openinference.retrieval",
      "doc": "What a retrieval returned. One message holding every document, not one each: they are a result set, and splitting them would read as a conversation.",
      "read": {
        "indexed_family": "retrieval.documents",
        "entry_member": "document",
        "numeric_members": [
          "score"
        ]
      },
      "require_members": {
        "any_of": [
          {
            "name": "id"
          },
          {
            "name": "content"
          },
          {
            "name": "score"
          },
          {
            "name": "metadata"
          }
        ]
      },
      "aggregate_into_array": true,
      "tag_as": "retrieval.documents",
      "wrap": {
        "role": "documents",
        "members": {
          "_source": "retrieval.documents"
        }
      },
      "legacy_rank": 220
    },
    {
      "id": "openinference.reranker_input",
      "doc": "The documents a reranker was given.",
      "read": {
        "indexed_family": "reranker.input_documents",
        "entry_member": "document",
        "numeric_members": [
          "score"
        ]
      },
      "require_members": {
        "any_of": [
          {
            "name": "id"
          },
          {
            "name": "content"
          },
          {
            "name": "score"
          },
          {
            "name": "metadata"
          }
        ]
      },
      "aggregate_into_array": true,
      "tag_as": "reranker.input_documents",
      "wrap": {
        "role": "documents",
        "members": {
          "_source": "reranker.input_documents"
        }
      },
      "legacy_rank": 230
    },
    {
      "id": "openinference.reranker_output",
      "doc": "The order it put them in.",
      "read": {
        "indexed_family": "reranker.output_documents",
        "entry_member": "document",
        "numeric_members": [
          "score"
        ]
      },
      "require_members": {
        "any_of": [
          {
            "name": "id"
          },
          {
            "name": "content"
          },
          {
            "name": "score"
          },
          {
            "name": "metadata"
          }
        ]
      },
      "aggregate_into_array": true,
      "tag_as": "reranker.output_documents",
      "wrap": {
        "role": "documents",
        "members": {
          "_source": "reranker.output_documents"
        }
      },
      "legacy_rank": 240
    },
    {
      "id": "openinference.reranker_query",
      "doc": "The query a reranker scored against.",
      "read": {
        "attribute": "reranker.query"
      },
      "parse": "text",
      "wrap": {
        "role": "user",
        "members": {
          "_source": "reranker.query"
        }
      },
      "legacy_rank": 250
    },
    {
      "id": "openinference.embedding_text",
      "doc": "The text an embedding span turned into a vector.",
      "read": {
        "attribute": "embedding.text"
      },
      "parse": "text",
      "wrap": {
        "role": "user",
        "members": {
          "_source": "embedding.text"
        }
      },
      "legacy_rank": 260
    }
  ],
  "span_facts": [
    {
      "id": "openinference.tool_execution",
      "doc": "This dialect states a span's kind directly, in capitals.",
      "fact": "tool_execution",
      "signals": [
        {
          "attr_equals": {
            "key": "openinference.span.kind",
            "value": "tool"
          },
          "ignore_case": true
        }
      ]
    }
  ]
}
