{
  "id": "mlflow",
  "doc": "The MLflow dialect.",
  "carriers": [
    {
      "id": "mlflow.span_inputs",
      "doc": "What the span received, as an array that expands into one observation per message.",
      "match": {
        "attribute": "mlflow.spanInputs"
      },
      "facts": {
        "preset": "snapshot",
        "carrier_holds_span_input": true,
        "carrier_holds_expandable_message_array": true
      }
    },
    {
      "id": "mlflow.span_outputs",
      "doc": "What it produced, likewise an array.",
      "match": {
        "attribute": "mlflow.spanOutputs"
      },
      "facts": {
        "preset": "snapshot",
        "carrier_holds_span_output": true,
        "carrier_holds_expandable_message_array": true
      }
    }
  ],
  "detect": [
    {
      "id": "mlflow.detect",
      "doc": "Identifies MLflow by the signals below.",
      "label": "MLflow",
      "match": {
        "attr_prefix": [
          "mlflow."
        ]
      },
      "legacy_rank": 210
    }
  ],
  "sdk_slugs": [
    {
      "slug": "mlflow",
      "label": "MLflow"
    }
  ],
  "messages": [
    {
      "id": "mlflow.span_inputs",
      "doc": "MLflow's span input payload.",
      "read": {
        "attribute": "mlflow.spanInputs"
      },
      "parse": "json",
      "emit": "message",
      "legacy_rank": 900
    },
    {
      "id": "mlflow.span_outputs",
      "doc": "MLflow's span output payload.",
      "read": {
        "attribute": "mlflow.spanOutputs"
      },
      "parse": "json",
      "emit": "message",
      "legacy_rank": 910
    },
    {
      "id": "mlflow.chat_tools",
      "doc": "The tool definitions the call was given - a definition rather than a message, which is why the emit target is its own declared fact.",
      "read": {
        "attribute": "mlflow.chat.tools"
      },
      "parse": "json",
      "emit": "tool_definitions",
      "legacy_rank": 920
    }
  ]
}
