{
  "id": "autogen",
  "doc": "The AutoGen dialect. Its messages arrive as typed objects - a type name per shape - which is why the table below is a fragment: the same vocabulary is written at five different selection points.",
  "carriers": [],
  "detect": [
    {
      "id": "autogen.detect",
      "doc": "OpenInference's AutoGen instrumentation sets gen_ai.system while service.name may still be the default, so the system value is a signal in its own right.",
      "label": "AutoGen",
      "match": {
        "span_name": [
          "autogen ",
          "autogen."
        ],
        "attr_prefix": [
          "autogen."
        ],
        "attr_equals": [
          {
            "key": "gen_ai.system",
            "value": "autogen"
          }
        ]
      },
      "legacy_rank": 10
    }
  ],
  "sdk_slugs": [
    {
      "slug": "autogen",
      "label": "AutoGen"
    }
  ],
  "messages": [
    {
      "id": "autogen.aggregate_input",
      "doc": "An agent span's `input.value` holds a Python `repr` of framework internals - a cancellation token, a flag - rather than a conversation; the messages come from its children. Claimed so a generic reader does not present that text as one, and read for nothing.",
      "read": {
        "attribute": "input.value"
      },
      "parse": "json",
      "emit": "claim",
      "legacy_rank": 1600,
      "alternatives": [
        {
          "doc": "Read for nothing; the claim is the whole effect.",
          "require": {
            "any": [
              {
                "path": "$.cancellation_token",
                "exists": true
              },
              {
                "path": "$.output_task_messages",
                "exists": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": "autogen.message",
      "doc": "The dialect's message carrier. It holds a typed message, a list of them, one nested under `message`, or a response with its reply and the inner turns that produced it - so the shapes are ordered and the first that fits is read.",
      "read": {
        "attribute": "message"
      },
      "parse": "json",
      "unless": {
        "attr_equals": [
          {
            "key": "message",
            "value": "No Message"
          },
          {
            "key": "message",
            "value": "{}"
          }
        ]
      },
      "alternatives": [
        {
          "doc": "The attribute is the message.",
          "then_fragment": "autogen.message"
        },
        {
          "doc": "A list of them.",
          "select": "$.messages",
          "each": true,
          "then_fragment": "autogen.message",
          "extra_cases": [
            {
              "doc": "A shape the table refused that still carries content - read here rather than dropped.",
              "require": {
                "all": [
                  {
                    "path": "$.content",
                    "exists": true
                  }
                ]
              }
            }
          ]
        },
        {
          "doc": "One nested under `message`.",
          "select": "$.message",
          "then_fragment": "autogen.message",
          "extra_cases": [
            {
              "doc": "A shape the table refused that still carries content - read here rather than dropped.",
              "require": {
                "all": [
                  {
                    "path": "$.content",
                    "exists": true
                  }
                ]
              }
            }
          ]
        },
        {
          "doc": "A response's own reply.",
          "select": "$.response.chat_message",
          "then_fragment": "autogen.message"
        },
        {
          "doc": "Neither, but message-shaped.",
          "require": {
            "all": [
              {
                "kind": "object"
              }
            ],
            "any": [
              {
                "path": "$.content",
                "exists": true
              },
              {
                "path": "$.role",
                "exists": true
              }
            ]
          }
        }
      ],
      "legacy_rank": 1610,
      "also": [
        {
          "doc": "The turns inside a response, after its reply. Additive rather than ordered: a response carries both.",
          "select": "$.response.inner_messages",
          "each": true,
          "then_fragment": "autogen.message"
        }
      ]
    },
    {
      "id": "autogen.body",
      "doc": "The dialect's own logging channel. One carrier holds a model call - the conversation it was given, its reply and the tools it was offered - or a single tool execution, so the readings are additive and each says what it is.",
      "read": {
        "attribute": "body"
      },
      "parse": "json",
      "also": [
        {
          "require": {},
          "select": "$.messages",
          "each": true,
          "then_fragment": "autogen.message",
          "extra_cases": [
            {
              "doc": "A shape the table refused that carries a role or content.",
              "require": {
                "any": [
                  {
                    "path": "$.role",
                    "exists": true
                  },
                  {
                    "path": "$.content",
                    "exists": true
                  }
                ]
              }
            }
          ],
          "require_parent": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "LLMCall",
                  "LLMStreamEnd"
                ]
              },
              {
                "path": "$.messages",
                "exists": true
              }
            ]
          }
        },
        {
          "require": {},
          "select": "$.response",
          "wrap": {
            "role": "assistant",
            "content_from_any_of": [
              "$.content",
              "$.choices[0].message.content"
            ],
            "attach": [
              {
                "after_content": true,
                "from_value_any_of": [
                  "$.tool_calls",
                  "$.choices[0].message.tool_calls"
                ],
                "require": {
                  "all": [
                    {
                      "non_empty": true
                    }
                  ]
                },
                "as": "tool_calls"
              }
            ]
          },
          "require_parent": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "LLMCall",
                  "LLMStreamEnd"
                ]
              }
            ]
          }
        },
        {
          "require": {},
          "select": "$.tools",
          "emit": "tool_definitions",
          "doc": "The tools the call was offered. A set, not a sequence of turns.",
          "require_parent": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "LLMCall",
                  "LLMStreamEnd"
                ]
              }
            ]
          }
        },
        {
          "require": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "ToolCall"
                ]
              }
            ]
          },
          "wrap": {
            "role": "tool",
            "content_from": "$.result",
            "content_default": null,
            "attach": [
              {
                "from_value_any_of": [
                  "$.tool_name"
                ],
                "default": "unknown",
                "as": "name"
              }
            ],
            "tool_call_from": {
              "name": "$.tool_name",
              "arguments": "$.arguments",
              "arguments_default": {},
              "name_default": "unknown"
            }
          }
        }
      ],
      "legacy_rank": 1620
    },
