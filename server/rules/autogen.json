  "fragments": {
    "message": {
      "doc": "What an AutoGen message is. The discriminator is the `type` member; a value the table does not know is passed through rather than dropped, and an untyped object is recognised by its shape. Ordered cases: the first that fits wins.",
      "cases": [
        {
          "doc": "A system instruction.",
          "require": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "SystemMessage"
                ]
              },
              {
                "path": "$.content",
                "exists": true
              }
            ]
          },
          "wrap": {
            "role": "system",
            "content_from": "$.content"
          }
        },
        {
          "doc": "A user turn addressed to the model.",
          "require": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "UserMessage"
                ]
              },
              {
                "path": "$.content",
                "exists": true
              }
            ]
          },
          "wrap": {
            "role": "user",
            "content_from": "$.content",
            "attach": [
              {
                "from_value_any_of": [
                  "$.source"
                ],
                "after_content": true,
                "as": "name"
              }
            ]
          }
        },
        {
          "doc": "The model's reply. Reasoning arrives in a sibling member and becomes a thinking block ahead of the text, so the two are one turn rather than two messages.",
          "require": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "AssistantMessage"
                ]
              },
              {
                "path": "$.content",
                "exists": true
              }
            ]
          },
          "wrap": {
            "role": "assistant",
            "content_from": "$.content",
            "attach": [
              {
                "from_value_any_of": [
                  "$.source"
                ],
                "as": "name"
              }
            ],
            "prepend_block": {
              "type": "thinking",
              "content_as": "text",
              "attach": [
                {
                  "value": null,
                  "after_content": true,
                  "as": "signature"
                }
              ],
              "from": "$.thought",
              "require": {
                "all": [
                  {
                    "not_null": true
                  },
                  {
                    "non_empty": true
                  }
                ]
              }
            }
          }
        },
        {
          "require": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "TextMessage"
                ]
              },
              {
                "path": "$.content",
                "exists": true
              }
            ]
          },
          "wrap": {
            "role_from": "$.source",
            "role_map": {
              "user": "user"
            },
            "role_map_is_closed": true,
            "role": "assistant",
            "content_from": "$.content",
            "attach": [
              {
                "from_value_any_of": [
                  "$.source"
                ],
                "require": {
                  "all": [
                    {
                      "none_of": [
                        "user"
                      ]
                    }
                  ]
                },
                "after_content": true,
                "as": "name"
              }
            ]
          },
          "doc": "An agent's utterance; `source` names the speaker."
        },
        {
          "require": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "MultiModalMessage"
                ]
              },
              {
                "path": "$.content",
                "exists": true
              }
            ]
          },
          "wrap": {
            "role_from": "$.source",
            "role_map": {
              "user": "user"
            },
            "role_map_is_closed": true,
            "role": "assistant",
            "content_from": "$.content",
            "attach": [
              {
                "from_value_any_of": [
                  "$.source"
                ],
                "require": {
                  "all": [
                    {
                      "none_of": [
                        "user"
                      ]
                    }
                  ]
                },
                "after_content": true,
                "as": "name"
              }
            ]
          },
          "doc": "An utterance carrying images beside its text."
        },
        {
          "require": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "StopMessage"
                ]
              },
              {
                "path": "$.content",
                "exists": true
              }
            ]
          },
          "wrap": {
            "role_from": "$.source",
            "role_map": {
              "user": "user"
            },
            "role_map_is_closed": true,
            "role": "assistant",
            "content_from": "$.content",
            "attach": [
              {
                "from_value_any_of": [
                  "$.source"
                ],
                "require": {
                  "all": [
                    {
                      "none_of": [
                        "user"
                      ]
                    }
                  ]
                },
                "after_content": true,
                "as": "name"
              }
            ]
          },
          "doc": "The utterance that ended a conversation."
        },
        {
          "doc": "One agent handing the conversation to another.",
          "require": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "HandoffMessage"
                ]
              },
              {
                "path": "$.content",
                "exists": true
              }
            ]
          },
          "wrap": {
            "role": "assistant",
            "content_from": "$.content",
            "attach": [
              {
                "from_value_any_of": [
                  "$.source"
                ],
                "after_content": true,
                "require": {
                  "all": [
                    {
                      "kind": "string"
                    }
                  ]
                },
                "as": "name"
              }
            ]
          }
        },
        {
          "doc": "Reasoning reported on its own, as a thinking block. An empty one is not a thought.",
          "require": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "ThoughtEvent"
                ]
              },
              {
                "path": "$.content",
                "exists": true
              },
              {
                "path": "$.content",
                "non_empty": true
              }
            ]
          },
          "wrap": {
            "role": "assistant",
            "content_from": "$.content",
            "block": {
              "type": "thinking",
              "content_as": "text",
              "attach": [
                {
                  "value": null,
                  "after_content": true,
                  "as": "signature"
                }
              ]
            }
          }
        },
        {
          "doc": "The model asking for tools to run.",
          "require": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "ToolCallRequestEvent"
                ]
              },
              {
                "path": "$.content",
                "kind": "array"
              },
              {
                "path": "$.content[?@.id && @.name]",
                "exists": true
              }
            ]
          },
          "wrap": {
            "role": "assistant",
            "tool_calls_from": {
              "select": "$.content[*]",
              "id": "$.id",
              "name": "$.name",
              "arguments": "$.arguments"
            },
            "attach": [
              {
                "from_value_any_of": [
                  "$.source"
                ],
                "after_content": true,
                "as": "name"
              }
            ]
          }
        },
        {
          "doc": "A batch of tool results, one message each.",
          "select": "$.content",
          "each": true,
          "lift_from_parent": [
            "call_id"
          ],
          "require": {
            "any": [
              {
                "path": "$.call_id",
                "exists": true
              },
              {
                "path": "$.name",
                "exists": true
              },
              {
                "path": "$.content",
                "non_empty": true
              }
            ]
          },
          "wrap": {
            "role": "tool",
            "content_from": "$.content",
            "content_default": "",
            "attach": [
              {
                "from_value_any_of": [
                  "$.name"
                ],
                "after_content": true,
                "as": "name"
              },
              {
                "from_value_any_of": [
                  "$.call_id"
                ],
                "after_content": true,
                "as": "tool_call_id"
              }
            ]
          },
          "require_parent": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "ToolCallExecutionEvent",
                  "FunctionExecutionResultMessage"
                ]
              },
              {
                "path": "$.content",
                "kind": "array"
              },
              {
                "path": "$.content",
                "non_empty": true
              }
            ]
          }
        },
        {
          "doc": "The dialect's own concatenation of tool results as Python `repr`. Claimed and read for nothing: every one of those results is reported individually, and this would repeat them as prose.",
          "require": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "ToolCallSummaryMessage"
                ]
              }
            ]
          },
          "emit": "claim"
        },
        {
          "doc": "A type this table does not know, carrying something a reader can still use. Passed through rather than dropped: an unrecognised name is not evidence there is no message.",
          "require": {
            "all": [
              {
                "path": "$.type",
                "exists": true
              }
            ],
            "any": [
              {
                "path": "$.role",
                "exists": true
              },
              {
                "path": "$.content",
                "exists": true
              }
            ]
          }
        },
        {
          "doc": "Untyped and already carrying a role: this is a message, not a dialect shape.",
          "require": {
            "all": [
              {
                "path": "$.type",
                "exists": false
              },
              {
                "path": "$.role",
                "exists": true
              }
            ]
          }
        },
        {
          "doc": "Untyped tool calls, recognised by an array whose members carry arguments.",
          "require": {
            "all": [
              {
                "path": "$.type",
                "exists": false
              },
              {
                "path": "$.content",
                "kind": "array"
              },
              {
                "path": "$.content[0].arguments",
                "exists": true
              },
              {
                "path": "$.content[?@.id && @.name]",
                "exists": true
              }
            ]
          },
          "wrap": {
            "role": "assistant",
            "tool_calls_from": {
              "select": "$.content[*]",
              "id": "$.id",
              "name": "$.name",
              "arguments": "$.arguments"
            },
            "attach": [
              {
                "from_value_any_of": [
                  "$.source"
                ],
                "after_content": true,
                "as": "name"
              }
            ]
          }
        },
        {
          "doc": "Untyped tool results: an array whose members name a call, or name a tool and carry content without asking for one.",
          "select": "$.content",
          "each": true,
          "lift_from_parent": [
            "call_id"
          ],
          "require": {
            "any": [
              {
                "path": "$.call_id",
                "exists": true
              },
              {
