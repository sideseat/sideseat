            {
              "key": "gen_ai.operation.name",
              "value": "invoke_swarm"
            },
            {
              "key": "gen_ai.operation.name",
              "value": "execute_event_loop_cycle"
            }
          ]
        }
      ],
      "result": "agent"
    },
    {
      "id": "category.named_tool",
      "rank": 100,
      "doc": "A tool name outranks an agent name here, which is the reverse of neither: the observation type asks the same pair in the other order, and both were transcribed as they stood.",
      "all_of": [
