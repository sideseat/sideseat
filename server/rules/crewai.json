{
  "id": "crewai",
  "doc": "The CrewAI dialect.",
  "carriers": [],
  "detect": [
    {
      "id": "crewai.detect",
      "doc": "CrewAI writes its own identifiers onto the span, and its telemetry service reports a distinctive name.",
      "label": "CrewAI",
      "match": {
        "service_name": [
          "crewAI-telemetry"
        ],
        "attr_exists": [
          "crewai_version",
          "crew_key",
          "crew_id",
          "crew_fingerprint",
          "task_key"
        ]
      },
      "legacy_rank": 30
    }
  ],
  "sdk_slugs": [
    {
      "slug": "crewai",
      "label": "CrewAI"
    }
  ],
  "messages": [
    {
      "id": "crewai.crew_tasks",
      "doc": "The crew's task definitions, kept whole.",
      "when": {
        "attr_exists": [
          "crew_key",
          "crew_id",
          "crew_tasks",
          "task_key"
        ]
      },
      "read": {
        "attribute": "crew_tasks"
      },
      "parse": "json",
      "emit": "message",
      "legacy_rank": 1500
    },
    {
      "id": "crewai.output",
      "doc": "One payload holding the history *and* the answer. The readings are cumulative, not alternatives: the turns live under `messages` (and under each task's own `messages`) while the answer itself is the top-level `raw`, so reading them as alternatives dropped the assistant output of every run that carried history - `crewai/reasoning` recorded three user turns and no answer, and the goldens recorded that as correct because no invariant requires an answer to exist. A turn must look like one (a role, and content or tool calls) so a task's other members are not mistaken for turns. The fallback keeps an unrecognised payload whole rather than leaving the span silently empty.",
      "when": {
        "attr_exists": [
          "crew_key",
          "crew_id",
          "crew_tasks",
          "task_key"
        ]
      },
      "read": {
        "attribute": "output.value"
      },
      "parse": "json",
      "emit": "message",
      "legacy_rank": 1510,
      "also": [
        {
          "doc": "The conversation's turns.",
          "select": "$.messages[*]",
          "require": {
            "all": [
              {
                "path": "$.role"
              }
            ],
            "any": [
              {
                "path": "$.content"
              },
              {
                "path": "$.tool_calls"
              },
              {
                "path": "$.toolCalls"
              }
            ]
          }
        },
        {
          "doc": "And each task's own turns.",
          "select": "$.tasks_output[*].messages[*]",
          "require": {
            "all": [
              {
                "path": "$.role"
              }
            ],
            "any": [
              {
                "path": "$.content"
              },
              {
                "path": "$.tool_calls"
              },
              {
                "path": "$.toolCalls"
              }
            ]
          }
        },
        {
          "doc": "The answer, which is a bare string beside them and so needs its own envelope.",
          "select": "$.raw",
          "trim": true,
          "require": {
            "all": [
              {
                "kind": "string",
                "non_empty": true
              }
            ]
          },
          "wrap": {
            "role": "assistant"
          }
        }
      ],
      "fallback": [
        {
          "doc": "No documented shape matched: keep the payload rather than nothing."
        }
      ]
    },
    {
      "id": "crewai.agent_task_tools",
      "doc": "The tools this dialect names in its agent and task metadata. An entry may be a tool itself or hold a list of them, and the same tool appears under both keys at different richness - so every carrier is read and the best copy per name wins.",
      "read": {
        "attribute_any_of": [
          "crew_agents",
          "crew_tasks"
        ]
      },
      "emit": "tool_definitions",
      "parse": "json",
      "when": {
        "attr_exists": [
          "crew_key",
          "crew_id",
          "crew_tasks",
          "task_key",
          "crew_agents"
        ]
      },
      "tool_repr": {
        "name_field": "name",
        "description_field": "description",
        "name_label": "Tool Name:",
        "description_label": "Tool Description:",
        "arguments_label": "Tool Arguments:",
        "repr_markers": [
          "name=",
          "Tool Name:",
          "CrewStructuredTool("
        ],
        "parameter_members": [
          "parameters",
          "input_schema",
          "args",
          "arguments",
          "tool_args",
          "tool_arguments"
        ],
        "type_map": [
          [
            "str",
            "string"
          ],
          [
            "string",
            "string"
          ],
          [
            "int",
            "integer"
          ],
          [
            "integer",
            "integer"
          ],
          [
            "float",
            "number"
          ],
          [
            "double",
            "number"
          ],
          [
            "number",
            "number"
          ],
          [
            "bool",
            "boolean"
          ],
          [
            "boolean",
            "boolean"
          ],
          [
            "list",
            "array"
          ],
          [
            "array",
            "array"
          ],
          [
            "dict",
            "object"
          ],
          [
            "object",
            "object"
          ]
        ],
        "type_default": "string",
        "doc": "An array of agent or task entries.",
        "entries": "$[*]",
        "candidates": [
          "$",
          "$.tools_names[*]",
          "$.tools[*]"
        ],
        "field_terminators": [
          "env_vars",
          "args_schema"
        ]
      },
      "legacy_rank": 1520
    },
    {
      "id": "crewai.input_value_tools",
      "doc": "The richer copy: this dialect logs its tool objects' `repr` here, with the arguments schema and the documentation embedded in a labelled string.",
      "read": {
        "attribute": "input.value"
      },
      "emit": "tool_definitions",
      "parse": "json",
      "when": {
        "attr_exists": [
          "crew_key",
          "crew_id",
          "crew_tasks",
          "task_key",
          "crew_agents"
        ]
      },
      "tool_repr": {
        "name_field": "name",
        "description_field": "description",
        "name_label": "Tool Name:",
        "description_label": "Tool Description:",
        "arguments_label": "Tool Arguments:",
        "repr_markers": [
          "name=",
          "Tool Name:",
          "CrewStructuredTool("
        ],
        "parameter_members": [
          "parameters",
          "input_schema",
          "args",
          "arguments",
          "tool_args",
          "tool_arguments"
        ],
        "type_map": [
          [
            "str",
            "string"
          ],
          [
            "string",
            "string"
          ],
          [
            "int",
            "integer"
          ],
          [
            "integer",
            "integer"
          ],
          [
            "float",
            "number"
          ],
          [
            "double",
            "number"
          ],
          [
            "number",
            "number"
          ],
          [
            "bool",
            "boolean"
          ],
          [
            "boolean",
            "boolean"
          ],
          [
            "list",
            "array"
          ],
          [
            "array",
            "array"
          ],
          [
            "dict",
            "object"
          ],
          [
            "object",
            "object"
          ]
        ],
        "type_default": "string",
        "doc": "One object holding a list of tools, a single tool, or both.",
        "entries": "$",
        "candidates": [
          "$.tools[*]",
          "$.tools",
          "$.tool"
        ],
        "field_terminators": [
          "env_vars",
          "args_schema"
        ]
      },
      "legacy_rank": 1530
    },
    {
      "id": "crewai.aggregate_input",
      "doc": "On a Crew span, `input.value` carries the framework's own state, including its tool objects' Python `repr`. The tools are read from it on the metadata axis; left unclaimed on the message axis, the generic reader presented that repr to the user as a turn.",
      "read": {
        "attribute": "input.value"
      },
      "parse": "json",
      "when": {
        "attr_exists": [
          "crew_key",
          "crew_id",
          "crew_tasks",
          "task_key",
          "crew_agents"
        ]
      },
      "emit": "claim",
      "alternatives": [
        {
          "doc": "Only where the tool list is what it holds. An **empty** list is not evidence of one - `crewai/error` carries `tools: []` beside the conversation, and claiming on presence alone took that turn away. And a `context` member is the conversation, so a carrier holding one is read rather than claimed.",
          "require": {
            "all": [
              {
                "path": "$.context",
                "exists": false,
                "doc": "The conversation, where this carrier has one."
              }
            ],
            "any": [
              {
                "path": "$.tools",
                "non_empty": true
              },
              {
                "path": "$.tool",
                "exists": true
              }
            ]
          }
        }
      ],
      "legacy_rank": 1515
    }
  ]
}
