      "id": "observation.agent_construction",
      "rank": 50,
      "doc": "One dialect emits `create_agent` for the *construction* of an agent, which ran no model and is not an agent invocation. Only that dialect's: the same operation name from anywhere else falls through, which is why this rule names the system as well.",
      "all_of": [
        {
          "attr_equals": [
            {
              "key": "gen_ai.operation.name",
              "value": "create_agent"
            }
          ]
