{
  "$schema": "../../rules.schema.json",
  "id": "agno",
  "doc": "The Agno dialect.",
  "carriers": [],
  "detect": [
    {
      "id": "agno.detect",
      "doc": "By attribute prefix only, never service.name: that dimension is a substring test, so `agno` would also match a service called `diagnostics`. Supersedes openinference.detect: this is the more specific dialect, and both match the same span, so the relationship is declared rather than left to the legacy rank.",
      "label": "Agno",
      "where": {
        "source": "attr_keys",
        "starts_with": "agno."
      },
      "priority": 70,
      "supersedes": [
        "openinference.detect"
      ]
    }
  ],
  "sdk_slugs": [
    {
      "slug": "agno",
      "label": "Agno"
    }
  ],
  "messages": [
    {
      "id": "agno.llm_output_messages",
      "doc": "A model call's response as Agno's instrumentor wrote it before it emitted `llm.output_messages`: the `output.value` of the LLM span holds the turns the call produced, as `{\"messages\": [...]}` or as the bare list. Read only where the indexed output family is absent, since later releases write both and the family is the richer copy.",
      "where": {
        "all": [
          {
            "source": "attr:openinference.span.kind",
            "equals": "LLM"
          },
          {
            "not": {
              "source": "attr:llm.output_messages.0.message.role",
              "exists": true
            }
          },
          {
            "source": "scope.name",
            "equals": "openinference.instrumentation.agno"
          }
        ]
      },
      "read": {
        "attribute": "output.value"
      },
      "parse": "json",
      "alternatives": [
        {
          "id": "messages",
          "doc": "One message each.",
          "select": "$.messages",
          "each": true,
          "where": {
            "path": "$.role",
            "kind": "string",
            "non_empty": true
          }
        },
        {
          "id": "list",
          "doc": "A call that only called tools writes the bare list.",
          "select": "$",
          "where": {
            "path": "$.role",
            "kind": "string",
            "non_empty": true
          },
          "each": true
        }
      ],
      "emit": "message",
      "priority": 2020
    },
    {
      "id": "agno.tool_output_literal",
      "doc": "A TOOL span's result as Agno records it: the Python `str()` of what the tool returned, so a dict arrives single-quoted. Read as the value it renders, with the tool's name - the span carries no call id, and query-time correlation pairs the result with the oldest unclaimed call of that name. A result that is not a whole Python container falls through to `agno.tool_output`.",
      "where": {
        "all": [
          {
            "source": "attr:openinference.span.kind",
            "equals_ignore_case": "tool"
          },
          {
            "source": "scope.name",
            "equals": "openinference.instrumentation.agno"
          }
        ]
      },
      "read": {
        "attribute": "output.value"
      },
      "parse": "python_literal",
      "wrap": {
        "role": "tool",
        "block": {
          "type": "tool_result",
          "attach": [
            {
              "from": "tool.name",
              "as": "name"
            }
          ]
        }
      },
      "emit": "message",
      "priority": 2021,
      "reads_tool_spans": true
    },
    {
      "id": "agno.tool_output",
      "doc": "The same result when it is JSON or text, with the tool's name.",
      "where": {
        "all": [
          {
            "source": "attr:openinference.span.kind",
            "equals_ignore_case": "tool"
          },
          {
            "source": "scope.name",
            "equals": "openinference.instrumentation.agno"
          }
        ]
      },
      "read": {
        "attribute": "output.value"
      },
      "parse": "json_or_string",
      "wrap": {
        "role": "tool",
        "block": {
          "type": "tool_result",
          "attach": [
            {
              "from": "tool.name",
              "as": "name"
            }
          ]
        }
      },
      "emit": "message",
      "priority": 2022,
      "reads_tool_spans": true
    }
  ]
}
