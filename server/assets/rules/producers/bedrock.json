{
  "$schema": "../../rules.schema.json",
  "id": "bedrock",
  "doc": "The AWSBedrock dialect.",
  "carriers": [],
  "detect": [
    {
      "id": "bedrock.detect",
      "doc": "Identifies AWSBedrock by the signals below.",
      "label": "AWSBedrock",
      "where": {
        "any": [
          {
            "source": "attr_keys",
            "starts_with": "aws.bedrock."
          },
          {
            "source": "attr:gen_ai.system",
            "one_of": [
              "aws_bedrock",
              "aws.bedrock"
            ]
          }
        ]
      },
      "priority": 260
    }
  ]
}
