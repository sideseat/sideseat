{
  "$schema": "../../rules.schema.json",
  "id": "traceloop",
  "doc": "Detects TraceLoop/OpenLLMetry spans. Decorator entity input and output are arbitrary function values, not conversation carriers; provider instrumentation supplies the GenAI message attributes.",
  "detect": [
    {
      "id": "traceloop.detect",
      "doc": "Identifies TraceLoop by the signals below.",
      "label": "TraceLoop",
      "where": {
        "any": [
          {
            "source": "attr_keys",
            "starts_with": "traceloop."
          },
          {
            "source": "resource:telemetry.sdk.name",
            "contains": "traceloop"
          }
        ]
      },
      "priority": 220
    }
  ],
  "observation_types": [
    {
      "id": "observation.traceloop_tool",
      "doc": "A TraceLoop tool decorator states the operation directly. This outranks the owning agent name that TraceLoop also copies onto the tool span.",
      "priority": 55,
      "where": {
        "source": "attr:traceloop.span.kind",
        "equals_ignore_case": "tool"
      },
      "result": "tool",
      "replaces_legacy_result": "agent"
    },
    {
      "id": "observation.traceloop_agent",
      "doc": "A TraceLoop agent decorator.",
      "priority": 56,
      "where": {
        "source": "attr:traceloop.span.kind",
        "equals_ignore_case": "agent"
      },
      "result": "agent"
    },
    {
      "id": "observation.traceloop_chain",
      "doc": "TraceLoop workflow and task decorators are orchestration spans rather than model generations.",
      "priority": 57,
      "where": {
        "any": [
          {
            "source": "attr:traceloop.span.kind",
            "equals_ignore_case": "workflow"
          },
          {
            "source": "attr:traceloop.span.kind",
            "equals_ignore_case": "task"
          }
        ]
      },
      "result": "chain",
      "replaces_legacy_result": "span"
    }
  ],
  "span_categories": [
    {
      "id": "category.traceloop_tool",
      "doc": "A TraceLoop tool decorator. This outranks the owning agent name that TraceLoop also copies onto the tool span.",
      "priority": 88,
      "where": {
        "source": "attr:traceloop.span.kind",
        "equals_ignore_case": "tool"
      },
      "result": "tool",
      "replaces_legacy_result": "agent"
    },
    {
      "id": "category.traceloop_agent",
      "doc": "A TraceLoop agent decorator.",
      "priority": 89,
      "where": {
        "source": "attr:traceloop.span.kind",
        "equals_ignore_case": "agent"
      },
      "result": "agent"
    },
    {
      "id": "category.traceloop_chain",
      "doc": "TraceLoop workflow and task decorators group orchestration work.",
      "priority": 91,
      "where": {
        "any": [
          {
            "source": "attr:traceloop.span.kind",
            "equals_ignore_case": "workflow"
          },
          {
            "source": "attr:traceloop.span.kind",
            "equals_ignore_case": "task"
          }
        ]
      },
      "result": "chain",
      "replaces_legacy_result": "other"
    }
  ],
  "span_facts": [
    {
      "id": "traceloop.tool_execution",
      "doc": "A TraceLoop tool decorator is the span that executed the tool.",
      "fact": "tool_execution",
      "signals": [
        {
          "id": "span_kind",
          "where": {
            "source": "attr:traceloop.span.kind",
            "equals_ignore_case": "tool"
          }
        }
      ]
    }
  ],
  "sdk_slugs": [
    {
      "slug": "traceloop",
      "label": "TraceLoop"
    }
  ],
  "content_blocks": [
    {
      "id": "traceloop.serialised_converse_block",
      "doc": "TraceLoop's Bedrock instrumentation writes a Converse content block it has no part type for - the model's reasoning - into a semconv text part as JSON text, so the reasoning rendered as raw JSON beside the answer. The block is decoded and read as the Converse block it is.",
      "at": "before_provider_formats",
      "priority": 87,
      "where": {
        "all": [
          {
            "path": "$.type",
            "one_of": [
              "text"
            ]
          },
          {
            "path": "$.content",
            "starts_with": "{\"reasoningContent\""
          }
        ]
      },
      "unwrap": {
        "from": [
          "$.content"
        ],
        "parse_json": true
      }
    }
  ]
}
