{
  "id": "haystack",
  "doc": "The Haystack dialect. The official OpenTelemetry integration writes structured agent, component and pipeline snapshots under `haystack.*`; model-step inputs may fall back to a Python repr when they contain callbacks or Tool objects, so the lossless aggregate snapshots are the authoritative conversation evidence.",
  "carriers": [
    {
      "id": "haystack.agent_step_llm_input",
      "doc": "The conversation and tools handed to one model step. It is a request snapshot and may repeat earlier turns.",
      "match": {
        "attribute": "haystack.agent.step.llm.input"
      },
      "facts": {
        "preset": "snapshot",
        "carrier_holds_span_input": true
      }
    },
    {
      "id": "haystack.agent_step_llm_output",
      "doc": "The replies produced by one model step.",
      "match": {
        "attribute": "haystack.agent.step.llm.output"
      },
      "facts": {
        "preset": "emission"
      }
    },
    {
      "id": "haystack.agent_input",
      "doc": "The conversation handed to an Agent invocation.",
      "match": {
        "attribute": "haystack.agent.input"
      },
      "facts": {
        "preset": "snapshot",
        "carrier_holds_span_input": true
      }
    },
    {
      "id": "haystack.agent_output",
      "doc": "The Agent's accumulated state after the invocation, including the full conversation.",
      "match": {
        "attribute": "haystack.agent.output"
      },
      "facts": {
        "preset": "accumulated_state",
        "history_positions_provide_sequence_order": true
      }
    },
    {
      "id": "haystack.component_input",
      "doc": "The input snapshot for one component invocation.",
      "match": {
        "attribute": "haystack.component.input"
      },
      "facts": {
        "preset": "snapshot",
        "carrier_holds_span_input": true
      }
    },
    {
      "id": "haystack.component_output",
      "doc": "A component's output state. Agent components repeat the accumulated conversation while chat generators carry their replies here.",
      "match": {
        "attribute": "haystack.component.output"
      },
      "facts": {
        "preset": "accumulated_state",
        "history_positions_provide_sequence_order": true
      }
    },
    {
      "id": "haystack.pipeline_input",
      "doc": "The pipeline input snapshot, keyed by component name.",
      "match": {
        "attribute": "haystack.pipeline.input_data"
      },
      "facts": {
        "preset": "snapshot",
        "carrier_holds_span_input": true
      }
    },
    {
      "id": "haystack.pipeline_output",
      "doc": "The pipeline output state, keyed by component name.",
      "match": {
        "attribute": "haystack.pipeline.output_data"
      },
      "facts": {
        "preset": "accumulated_state",
        "history_positions_provide_sequence_order": true
      }
    },
    {
      "id": "haystack.agent_step_tool_input",
      "doc": "The arguments handed to one tool execution.",
      "match": {
        "attribute": "haystack.agent.step.tool.input"
      },
      "facts": {
        "preset": "emission",
        "carrier_holds_span_output": false,
        "carrier_holds_span_input": true
      }
    },
    {
      "id": "haystack.agent_step_tool_output",
      "doc": "The result produced by one tool execution.",
      "match": {
        "attribute": "haystack.agent.step.tool.output"
      },
      "facts": {
        "preset": "emission"
      }
    }
  ],
  "detect": [
    {
      "id": "haystack.detect",
      "doc": "Identifies Haystack by the official integration's scope, the older OpenInference scope or Haystack-owned attributes. Supersedes openinference.detect: this is the more specific dialect, and both may match the same span, so the relationship is declared rather than left to the legacy rank.",
      "label": "Haystack",
      "match": {
        "scope_name": [
          "haystack",
          "openinference.instrumentation.haystack"
        ],
        "attr_prefix": [
          "haystack."
        ]
      },
      "legacy_rank": 120,
      "supersedes": [
        "openinference.detect"
      ]
    }
  ],
  "sdk_slugs": [
    {
      "slug": "haystack",
      "label": "Haystack"
    }
  ],
  "span_facts": [
    {
      "id": "haystack.tool_execution",
      "doc": "The official tracer names a tool execution through its tool metadata and paired input/output carriers.",
      "fact": "tool_execution",
      "signals": [
        {
          "id": "agent_step_tool",
          "attrs_present": [
            "haystack.tool.name",
            "haystack.agent.step.tool.input",
            "haystack.agent.step.tool.output"
          ]
        }
      ]
    }
  ],
  "observation_types": [
    {
      "id": "observation.haystack_agent_step_llm",
      "doc": "A Haystack model step. The exact operation outranks the weaker `agent` substring in its name.",
      "rank": 47,
      "all_of": [
        {
          "span_name_exact": [
            "haystack.agent.step.llm"
          ]
        }
      ],
      "result": "generation",
      "replaces_legacy_result": "agent"
    },
    {
      "id": "observation.haystack_agent_step_tool",
      "doc": "A Haystack tool step.",
      "rank": 48,
      "all_of": [
        {
          "span_name_exact": [
            "haystack.agent.step.tool"
          ]
        }
      ],
      "result": "tool",
      "replaces_legacy_result": "agent"
    },
    {
      "id": "observation.haystack_agent",
      "doc": "The Agent invocation and its loop steps.",
      "rank": 49,
      "all_of": [
        {
          "span_name_exact": [
            "haystack.agent.run",
            "haystack.agent.step"
          ]
        }
      ],
      "result": "agent"
    },
    {
      "id": "observation.haystack_chat_generator_component",
      "doc": "A chat-generator component is a model generation even though its generic span name only says `component`.",
      "rank": 51,
      "all_of": [
        {
          "span_name_exact": [
            "haystack.component.run"
          ]
        },
        {
          "attr_equals": [
            {
              "key": "haystack.component.type",
              "value": "OpenAIChatGenerator"
            }
          ]
        }
      ],
      "result": "generation",
      "replaces_legacy_result": "span"
    },
    {
      "id": "observation.haystack_agent_component",
      "doc": "The component wrapper around an Agent invocation.",
      "rank": 52,
      "all_of": [
        {
          "span_name_exact": [
            "haystack.component.run"
          ]
        },
        {
          "attr_equals": [
            {
              "key": "haystack.component.type",
              "value": "Agent"
            }
          ]
        }
      ],
      "result": "agent",
      "replaces_legacy_result": "span"
    },
    {
      "id": "observation.haystack_pipeline",
      "doc": "A pipeline coordinates component invocations.",
      "rank": 53,
      "all_of": [
        {
          "span_name_exact": [
            "haystack.pipeline.run"
          ]
        }
      ],
      "result": "chain",
      "replaces_legacy_result": "span"
    },
    {
      "id": "observation.haystack_component",
      "doc": "A component without a more specific declared operation is one step in a chain.",
      "rank": 54,
      "all_of": [
        {
          "span_name_exact": [
            "haystack.component.run"
          ]
        }
      ],
      "result": "chain",
      "replaces_legacy_result": "span"
    }
  ],
  "span_categories": [
    {
      "id": "category.haystack_agent_step_llm",
      "rank": 81,
      "all_of": [
        {
          "span_name_exact": [
            "haystack.agent.step.llm"
          ]
        }
      ],
      "result": "llm",
      "replaces_legacy_result": "other"
    },
    {
      "id": "category.haystack_agent_step_tool",
      "rank": 82,
      "all_of": [
        {
          "span_name_exact": [
            "haystack.agent.step.tool"
          ]
        }
      ],
      "result": "tool",
      "replaces_legacy_result": "other"
    },
    {
      "id": "category.haystack_chat_generator_component",
      "rank": 83,
      "all_of": [
        {
          "span_name_exact": [
            "haystack.component.run"
          ]
        },
        {
          "attr_equals": [
            {
              "key": "haystack.component.type",
              "value": "OpenAIChatGenerator"
            }
          ]
        }
      ],
      "result": "llm",
      "replaces_legacy_result": "other"
    },
    {
      "id": "category.haystack_agent",
      "rank": 84,
      "all_of": [
        {
          "span_name_exact": [
            "haystack.agent.run",
