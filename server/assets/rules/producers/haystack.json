    },
    {
      "id": "category.haystack_pipeline",
      "rank": 86,
      "all_of": [
        {
          "span_name_exact": [
            "haystack.pipeline.run"
          ]
        }
      ],
      "result": "chain",
      "replaces_legacy_result": "other"
    },
    {
      "id": "category.haystack_component",
      "rank": 87,
      "all_of": [
        {
          "span_name_exact": [
            "haystack.component.run"
          ]
        }
      ],
      "result": "chain",
      "replaces_legacy_result": "other"
    }
  ],
  "messages": [
    {
      "id": "haystack.agent_step_llm_input",
      "doc": "A model step's structured request. Haystack falls back to Python repr when callbacks or Tool objects are present; JSON snapshots on the enclosing Agent remain authoritative for those cases, so an unreadable repr is deliberately not converted into a fake text turn.",
      "instrumentation_scope": {
        "name": "haystack"
      },
      "when": {
        "span_name_exact": [
          "haystack.agent.step.llm"
        ]
      },
      "read": {
        "attribute": "haystack.agent.step.llm.input"
      },
      "parse": "json",
      "also": [
        {
          "id": "messages",
          "select": "$.messages[*]",
          "require": {
            "all": [
              {
                "path": "$.role"
              },
              {
                "path": "$.content"
              }
            ]
          }
        },
        {
          "id": "tools",
          "doc": "Serializable Tool objects are wrapped under `data` by Haystack's dataclass serialiser.",
          "select": "$.tools[*].data",
          "emit": "tool_definitions"
        }
      ],
      "legacy_rank": 1700
    },
    {
      "id": "haystack.agent_step_llm_output",
      "doc": "The replies emitted by one model step.",
      "instrumentation_scope": {
        "name": "haystack"
      },
      "when": {
        "span_name_exact": [
          "haystack.agent.step.llm"
        ]
      },
      "read": {
        "attribute": "haystack.agent.step.llm.output"
      },
      "parse": "json",
      "alternatives": [
        {
          "id": "replies",
          "select": "$.replies[*]",
          "require": {
            "all": [
              {
                "path": "$.role"
              },
              {
                "path": "$.content"
              }
            ]
          }
        }
      ],
      "legacy_rank": 1710
    },
    {
      "id": "haystack.agent_input",
      "doc": "The conversation supplied to one Agent invocation.",
      "instrumentation_scope": {
        "name": "haystack"
      },
      "when": {
        "span_name_exact": [
          "haystack.agent.run"
        ]
      },
      "read": {
        "attribute": "haystack.agent.input"
      },
      "parse": "json",
      "alternatives": [
        {
          "id": "messages",
          "select": "$.messages[*]",
          "require": {
            "all": [
              {
                "path": "$.role"
              },
              {
                "path": "$.content"
              }
            ]
          }
        }
      ],
      "legacy_rank": 1720
    },
    {
      "id": "haystack.agent_output",
      "doc": "The full, structured conversation after one Agent invocation.",
      "instrumentation_scope": {
        "name": "haystack"
      },
      "when": {
        "span_name_exact": [
          "haystack.agent.run"
        ]
      },
      "read": {
        "attribute": "haystack.agent.output"
      },
      "parse": "json",
      "alternatives": [
        {
          "id": "messages",
          "select": "$.messages[*]",
          "require": {
            "all": [
              {
                "path": "$.role"
              },
              {
                "path": "$.content"
              }
            ]
          }
        }
      ],
      "legacy_rank": 1730
    },
    {
      "id": "haystack.component_input",
      "doc": "Messages and tool definitions handed to a component. Agent and chat-generator components use the same carrier with different envelopes.",
      "instrumentation_scope": {
        "name": "haystack"
      },
      "when": {
        "span_name_exact": [
          "haystack.component.run"
        ]
      },
      "read": {
        "attribute": "haystack.component.input"
      },
      "parse": "json",
      "also": [
        {
          "id": "messages",
          "select": "$.messages[*]",
          "require": {
            "all": [
              {
                "path": "$.role"
              },
              {
                "path": "$.content"
              }
            ]
          }
        },
        {
          "id": "tools",
          "select": "$.tools[*].data",
          "emit": "tool_definitions"
        }
      ],
      "legacy_rank": 1740
    },
    {
      "id": "haystack.component_output",
      "doc": "Agent components expose `messages`; chat generators expose `replies`. Both are additive readings because a component may legally carry both.",
      "instrumentation_scope": {
        "name": "haystack"
      },
      "when": {
        "span_name_exact": [
          "haystack.component.run"
        ]
      },
      "read": {
        "attribute": "haystack.component.output"
      },
      "parse": "json",
      "also": [
        {
          "id": "messages",
          "select": "$.messages[*]",
          "require": {
            "all": [
              {
                "path": "$.role"
              },
              {
                "path": "$.content"
              }
            ]
          }
        },
        {
          "id": "replies",
          "select": "$.replies[*]",
          "require": {
            "all": [
              {
                "path": "$.role"
              },
              {
                "path": "$.content"
              }
            ]
          }
        }
      ],
      "legacy_rank": 1750
    },
    {
      "id": "haystack.pipeline_input",
      "doc": "Pipeline inputs are keyed by component name; each component's message list is a request snapshot.",
      "instrumentation_scope": {
        "name": "haystack"
      },
      "when": {
        "span_name_exact": [
          "haystack.pipeline.run"
        ]
      },
      "read": {
        "attribute": "haystack.pipeline.input_data"
      },
      "parse": "json",
      "also": [
        {
          "id": "messages",
          "select": "$.*.messages[*]",
          "require": {
            "all": [
              {
                "path": "$.role"
              },
              {
                "path": "$.content"
              }
            ]
          }
        },
        {
          "id": "tools",
          "select": "$.*.tools[*].data",
          "emit": "tool_definitions"
        }
      ],
      "legacy_rank": 1760
    },
    {
      "id": "haystack.pipeline_output",
      "doc": "Pipeline outputs are keyed by component name and may contain either an accumulated conversation or generator replies.",
      "instrumentation_scope": {
        "name": "haystack"
      },
      "when": {
        "span_name_exact": [
          "haystack.pipeline.run"
        ]
      },
      "read": {
        "attribute": "haystack.pipeline.output_data"
      },
      "parse": "json",
      "also": [
        {
          "id": "messages",
          "select": "$.*.messages[*]",
          "require": {
            "all": [
              {
                "path": "$.role"
              },
              {
                "path": "$.content"
              }
            ]
          }
        },
        {
          "id": "replies",
          "select": "$.*.replies[*]",
          "require": {
            "all": [
              {
                "path": "$.role"
              },
              {
                "path": "$.content"
              }
            ]
          }
        }
      ],
      "legacy_rank": 1770
    },
    {
      "id": "haystack.agent_step_tool_input",
      "doc": "The call represented by a tool span. The official tracer does not repeat the call id here, so query-time name and argument correlation joins it to the richer Agent snapshot.",
      "instrumentation_scope": {
        "name": "haystack"
      },
      "when": {
        "span_name_exact": [
          "haystack.agent.step.tool"
        ]
      },
      "read": {
        "attribute": "haystack.agent.step.tool.input"
      },
      "parse": "json_or_string",
      "wrap": {
        "role": "assistant",
        "block": {
          "type": "tool_use",
          "content_as": "input",
          "attach": [
            {
              "from": "haystack.tool.name",
              "as": "name",
              "default": ""
            }
          ]
        }
      },
      "emit": "message",
      "legacy_rank": 1780,
      "reads_tool_spans": true
    },
    {
      "id": "haystack.agent_step_tool_output",
      "doc": "The result represented by a tool span. It keeps the tool name even though the official tracer omits the call id from this span.",
      "instrumentation_scope": {
        "name": "haystack"
      },
      "when": {
        "span_name_exact": [
          "haystack.agent.step.tool"
        ]
      },
      "read": {
        "attribute": "haystack.agent.step.tool.output"
      },
      "parse": "json_or_string",
      "wrap": {
        "role": "tool",
        "block": {
          "type": "tool_result",
          "attach": [
            {
              "from": "haystack.tool.name",
              "as": "name"
            }
          ]
        }
      },
      "emit": "message",
      "legacy_rank": 1790,
      "reads_tool_spans": true
    },
    {
      "id": "haystack.agent_tools",
      "doc": "The official tracer serialises a non-empty Agent tool list as Python repr. The generic repr grammar keeps the tool's name and description instead of presenting framework internals as a conversation turn.",
      "instrumentation_scope": {
        "name": "haystack"
      },
      "when": {
        "span_name_exact": [
          "haystack.agent.run"
        ]
      },
      "read": {
        "attribute": "haystack.agent.tools"
      },
      "parse": "json_or_string",
      "emit": "tool_definitions",
      "tool_repr": {
        "name_field": "name",
        "description_field": "description",
        "name_label": "Tool Name:",
        "description_label": "Tool Description:",
        "arguments_label": "Tool Arguments:",
        "repr_markers": [
          "Tool("
        ],
        "parameter_members": [
          "parameters"
        ],
        "type_map": [
          [
            "str",
            "string"
          ],
          [
            "string",
            "string"
          ],
          [
            "int",
            "integer"
          ],
          [
            "integer",
            "integer"
          ],
          [
            "float",
            "number"
          ],
          [
            "number",
            "number"
          ],
          [
            "bool",
            "boolean"
          ],
          [
            "boolean",
            "boolean"
          ],
          [
            "list",
            "array"
          ],
          [
            "array",
            "array"
          ],
          [
            "dict",
            "object"
          ],
          [
            "object",
            "object"
          ]
        ],
        "type_default": "unconstrained",
        "entries": "$",
        "candidates": [
          "$"
        ],
        "field_terminators": [
          "parameters",
          "function",
          "outputs_to_string",
          "inputs_from_state",
          "outputs_to_state",
          "async_function"
        ]
      },
      "legacy_rank": 1800
    }
  ],
  "content_blocks": [
    {
      "id": "haystack.tool_call",
      "doc": "Haystack wraps a model tool call in a `tool_call` member.",
      "at": "before_provider_formats",
      "legacy_rank": 100,
      "require": {
        "all": [
          {
            "path": "$.tool_call.tool_name",
            "exists": true
          }
        ]
      },
      "tool_use": {
        "id": [
          "$.tool_call.id"
        ],
        "name": [
          "$.tool_call.tool_name"
        ],
        "input": [
          "$.tool_call.arguments"
        ]
      }
    },
    {
      "id": "haystack.tool_call_result",
      "doc": "Haystack wraps a tool result together with the originating call, preserving the id needed for exact pairing.",
      "at": "before_provider_formats",
      "legacy_rank": 110,
      "require": {
        "all": [
          {
            "path": "$.tool_call_result.origin.tool_name",
            "exists": true
          }
        ]
      },
      "tool_result": {
        "tool_use_id": [
          "$.tool_call_result.origin.id"
        ],
        "name": [
          "$.tool_call_result.origin.tool_name"
        ],
        "content": [
          "$.tool_call_result.result"
        ],
        "is_error": [
          "$.tool_call_result.error"
        ]
      }
    },
    {
      "id": "haystack.reasoning_content",
      "at": "message_envelope",
      "legacy_rank": 15,
      "doc": "Haystack's reasoning part: the text under `reasoning_text` beside an `extra` member holding the provider's own fields. Ranked before the shared reasoning envelope, which reads `text` and would make this an empty block.",
      "require": {
        "all": [
          {
            "path": "$.reasoning.reasoning_text",
            "kind": "string"
          }
        ]
      },
      "thinking": {
        "text": [
          "$.reasoning.reasoning_text"
        ],
        "signature": [
          "$.reasoning.extra.signature"
        ]
      }
    }
  ]
}
