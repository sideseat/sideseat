{
  "$schema": "../../rules.schema.json",
  "id": "agent-framework",
  "doc": "The AgentFramework dialect.",
  "carriers": [],
  "detect": [
    {
      "id": "agent-framework.detect",
      "doc": "Identifies AgentFramework by the signals below.",
      "label": "AgentFramework",
      "match": {
        "attr_equals": [
          {
            "key": "gen_ai.provider.name",
            "value": "microsoft.agent_framework"
          }
        ],
        "service_name": [
          "agent-framework-core"
        ]
      },
      "legacy_rank": 250
    }
  ],
  "sdk_slugs": [
    {
      "slug": "agent-framework",
      "label": "AgentFramework"
    }
  ],
  "content_blocks": [
    {
      "id": "agent-framework.data_part",
      "at": "provider_formats",
      "legacy_rank": 1100,
      "require": {
        "all": [
          {
            "path": "$.type",
            "one_of": [
              "data"
            ]
          }
        ]
      },
      "media": {
        "data": [
          "$.uri"
        ],
        "media_type": [
          "$.media_type"
        ],
        "missing_media_type": "null",
        "name": [
          "$.filename"
        ],
        "source": {
          "reference_or": "url"
        },
        "doc": "Binary data by URI, with the media type and filename beside it. A stored reference is a file; anything else is a location."
      }
    }
  ]
}
