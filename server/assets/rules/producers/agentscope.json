{
  "$schema": "../../rules.schema.json",
  "id": "agentscope",
  "doc": "The AgentScope dialect.",
  "carriers": [],
  "messages": [
    {
      "id": "agentscope.tool_call_result",
      "doc": "AgentScope serialises its completed ToolResponse as a Python constructor repr. Read only that repr on AgentScope's own instrumentation scope; ordinary JSON and text results fall through to the semantic-conventions rule. The content projection removes framework object ids and timestamps while preserving every returned block.",
      "read": {
        "attribute": "gen_ai.tool.call.result"
      },
      "parse": "python_constructor_repr",
      "wrap": {
        "role": "tool",
        "content_from_any_of": [
          "$.content"
        ],
        "block": {
          "type": "tool_result",
          "attach": [
            {
              "from": "gen_ai.tool.name",
              "as": "name",
              "or_span_name_after": "execute_tool "
            },
            {
              "from": "gen_ai.tool.call.id",
              "as": "tool_use_id"
            },
            {
              "from_value_any_of": [
                "$.state"
              ],
              "where": {
                "one_of": [
                  "error",
                  "denied",
                  "interrupted"
                ]
              },
              "as": "is_error",
              "value": true,
              "after_content": true
            }
          ]
        }
      },
      "emit": "message",
      "where": {
        "source": "scope.name",
        "equals": "agentscope"
      },
      "priority": 165,
      "reads_tool_spans": true
    },
    {
      "id": "agentscope.tool_call_result_blocks",
      "doc": "A tool that returns AgentScope's content blocks rather than a ToolResponse - an agent assigned work through a team pipeline - is serialised as a JSON list of block reprs. Read as JSON strings, the result kept every block's generated id and timestamp, so two runs of one conversation reported different results.",
      "read": {
        "attribute": "gen_ai.tool.call.result"
      },
      "parse": "python_constructor_repr_array",
      "wrap": {
        "role": "tool",
        "content_from_any_of": [
          "$"
        ],
        "block": {
          "type": "tool_result",
          "attach": [
            {
              "from": "gen_ai.tool.name",
              "as": "name",
              "or_span_name_after": "execute_tool "
            },
            {
              "from": "gen_ai.tool.call.id",
              "as": "tool_use_id"
            }
          ]
        }
      },
      "emit": "message",
      "where": {
        "source": "scope.name",
        "equals": "agentscope"
      },
      "priority": 166,
      "reads_tool_spans": true
    }
  ],
  "content_blocks": [
    {
      "id": "agentscope.data_block",
      "doc": "AgentScope DataBlock reprs retain a nested base64 or URL source. Constructor parsing exposes those fields; this declaration maps them to a canonical media block and leaves generated block ids and timestamps behind.",
      "at": "before_provider_formats",
      "priority": 80,
      "where": {
        "all": [
          {
            "path": "$.type",
            "one_of": [
              "data"
            ]
          },
          {
            "path": "$.source.media_type",
            "kind": "string"
          },
          {
            "any": [
              {
                "path": "$.source.data",
                "kind": "string"
              },
              {
                "path": "$.source.url.__python_args[0]",
                "kind": "string"
              },
              {
                "path": "$.source.url",
                "kind": "string"
              }
            ]
          }
        ]
      },
      "media": {
        "media_type": [
          "$.source.media_type"
        ],
        "data": [
          "$.source.data",
          "$.source.url.__python_args[0]",
          "$.source.url"
        ],
        "name": [
          "$.name"
        ]
      }
    },
    {
      "id": "agentscope.thinking_block",
      "doc": "AgentScope calls the reasoning text `thinking`; the canonical SideML block calls it `text`.",
      "at": "before_provider_formats",
      "priority": 90,
      "where": {
        "all": [
          {
            "path": "$.type",
            "one_of": [
              "thinking"
            ]
          },
          {
            "path": "$.thinking",
            "kind": "string"
          }
        ]
      },
      "thinking": {
        "text": [
          "$.thinking"
        ],
        "signature": [
          "$.signature"
        ]
      }
    }
  ],
  "detect": [
    {
      "id": "agentscope.detect",
      "doc": "Identifies AgentScope by the signals below. Supersedes openinference.detect: this is the more specific dialect, and both match the same span, so the relationship is declared rather than left to the legacy rank.",
      "label": "AgentScope",
      "where": {
        "source": "attr_keys",
        "starts_with": "agentscope."
      },
      "priority": 90,
      "supersedes": [
        "openinference.detect"
      ]
    }
  ],
  "sdk_slugs": [
    {
      "slug": "agentscope",
      "label": "AgentScope"
    }
  ]
}
