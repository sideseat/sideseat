{
  "$schema": "../../rules.schema.json",
  "id": "google-adk",
  "doc": "The GoogleADK dialect.",
  "carriers": [
    {
      "id": "google-adk.llm_request",
      "doc": "The request handed to the model.",
      "match": {
        "attribute": "gcp.vertex.agent.llm_request"
      },
      "facts": {
        "preset": "snapshot",
        "position_proves_distinct_occurrence": true,
        "carrier_holds_span_input": true
      }
    },
    {
      "id": "google-adk.agent_data",
      "doc": "State handed to an agent invocation.",
      "match": {
        "attribute": "gcp.vertex.agent.data"
      },
      "facts": {
        "preset": "snapshot",
        "carrier_holds_span_input": true
      }
    },
    {
      "id": "google-adk.llm_response",
      "doc": "What the model returned.",
      "match": {
        "attribute": "gcp.vertex.agent.llm_response"
      },
      "facts": {
        "preset": "emission"
      }
    },
    {
      "id": "google-adk.request_content",
      "doc": "A turn of the request a model call received, in the request's order. ADK for Go writes the whole request as events at request time, so a later trace re-sends an earlier trace's turns under the later trace's time: the replay is recognised by its place in the replayed prefix, never by its time.",
      "match": {
        "event": "google_adk.request_content"
      },
      "facts": {
        "preset": "snapshot",
        "carrier_holds_span_input": true,
        "carrier_replays_across_traces": true
      },
      "ordering_family": "google_adk.request_content"
    },
    {
      "id": "google-adk.choice_content",
      "doc": "The model's own output, one emission per call.",
      "match": {
        "event": "google_adk.choice_content"
      },
      "facts": {
        "preset": "emission"
      }
    }
  ],
  "detect": [
    {
      "id": "google-adk.detect",
      "doc": "Ranked ahead of every service-name fallback: ADK's own attributes are conclusive.",
      "label": "GoogleADK",
      "where": {
        "any": [
          {
            "source": "attr_keys",
            "starts_with": "google.adk."
          },
          {
            "source": "attr_keys",
            "starts_with": "gcp.vertex.agent."
          },
          {
            "source": "attr:gen_ai.system",
            "equals": "gcp.vertex.agent"
          }
        ]
      },
      "priority": 20
    }
  ],
  "sdk_slugs": [
    {
      "slug": "google-adk",
      "label": "GoogleADK"
    }
  ],
  "messages": [
    {
      "id": "google-adk.conversation",
      "priority": 500,
      "doc": "Every carrier this dialect writes a conversation to, with the local order between them: the tool-call arguments are read only when the request payload supplied nothing, which is what the code being replaced expressed as a `!found` check.",
      "branch_set": {
        "primary": [
          {
            "id": "google-adk.llm_request",
            "doc": "The request. Its members arrive under two spellings - the native Vertex form in camelCase and this framework's own in snake_case under `config` - so each reading lists both. An empty object is not a request.",
            "read": {
              "attribute": "gcp.vertex.agent.llm_request"
            },
            "parse": "json",
            "emit": "message",
            "also": [
              {
                "id": "parts",
                "doc": "The system instruction: structured parts, a bare string, or the framework's own snake_case member.",
                "select": "$.systemInstruction.parts",
                "wrap": {
                  "role": "system"
                }
              },
              {
                "id": "systeminstruction",
                "doc": "The same instruction written as a string.",
                "select": "$.systemInstruction",
                "require": {
                  "all": [
                    {
                      "kind": "string",
                      "non_empty": true
                    }
                  ]
                },
                "wrap": {
                  "role": "system"
                }
              },
              {
                "id": "system_instruction",
                "doc": "And the framework's own spelling.",
                "select": "$.config.system_instruction",
                "require": {
                  "all": [
                    {
                      "kind": "string",
                      "non_empty": true
                    }
                  ]
                },
                "wrap": {
                  "role": "system"
                }
              },
              {
                "id": "contents",
                "doc": "The conversation. Gemini writes `{parts, role}`, so the role comes from the payload rather than a literal - one rule per role would be the alternative. Read structurally so the provider's payload is cloned unchanged; see the projection-language section of `docs/engineering/framework-rules-engine.md` for why.",
                "select": "$.contents[*]",
                "require": {
                  "all": [
                    {
                      "path": "$.role"
                    },
                    {
                      "path": "$.parts"
                    }
                  ]
                },
                "wrap": {
                  "role_from": "$.role",
                  "content_from_any_of": [
                    "$.parts"
                  ]
                }
              }
            ]
          },
          {
            "id": "google-adk.llm_request_tools",
            "doc": "The tools the request was given, as one observation - a set, not a sequence of turns. Prefer the top-level list, else the nested one; each group either wraps its declarations under one of two spellings or is a declaration itself.",
            "read": {
              "attribute": "gcp.vertex.agent.llm_request"
            },
            "parse": "json",
            "emit": "tool_definitions",
            "aggregate_into_array": true,
            "alternatives": [
              {
                "id": "tools",
                "select": "$.tools",
                "each": true,
                "else_element": true,
                "then_present_any_of": [
                  "$.function_declarations",
                  "$.functionDeclarations"
                ]
              },
              {
                "id": "tools_2",
                "select": "$.config.tools",
                "each": true,
                "else_element": true,
                "then_present_any_of": [
                  "$.function_declarations",
                  "$.functionDeclarations"
                ]
              }
            ]
          }
        ],
        "fallback_if_primary_empty": [
          {
            "id": "google-adk.tool_call_args",
            "doc": "A tool call's arguments, read only when the request payload supplied nothing.",
            "read": {
              "attribute": "gcp.vertex.agent.tool_call_args"
            },
            "parse": "json",
            "emit": "message",
            "wrap": {
              "role": "tool_call"
            }
          }
        ],
        "always": [
          {
            "id": "google-adk.llm_response",
            "doc": "The response. `model` is this provider's name for the assistant, normalised here so the alias sits beside the dialect that uses it; the reason a turn stopped is reported beside the content rather than inside it, and lower-cased to the canonical form.",
            "read": {
              "attribute": "gcp.vertex.agent.llm_response"
            },
            "parse": "json",
            "emit": "message",
            "alternatives": [
              {
                "id": "content",
                "select": "$.content",
                "require": {
                  "all": [
                    {
                      "path": "$.role"
                    },
                    {
                      "path": "$.parts"
                    }
                  ]
                },
                "wrap": {
                  "role_from": "$.role",
                  "role_map": {
                    "model": "assistant"
                  },
                  "attach": [
                    {
                      "from_path": "$.finish_reason",
                      "as": "finish_reason",
                      "lowercase": true,
                      "after_content": true
                    }
                  ],
                  "content_from_any_of": [
                    "$.parts"
                  ]
                }
              }
            ]
          },
          {
            "id": "google-adk.tool_response",
            "doc": "What a tool returned.",
            "read": {
              "attribute": "gcp.vertex.agent.tool_response"
            },
            "parse": "json",
            "emit": "message",
            "wrap": {
              "role": "tool"
            }
          },
          {
            "id": "google-adk.data",
            "doc": "The conversation handed to an agent. Neither an empty object nor an empty list is a conversation.",
            "read": {
              "attribute": "gcp.vertex.agent.data"
            },
            "parse": "json",
            "emit": "message",
            "alternatives": [
              {
                "id": "alternative_1",
                "require": {
                  "all": [
                    {
                      "non_empty": true
                    }
                  ]
                }
              }
            ],
            "wrap": {
              "role": "data",
              "members": {
                "type": "conversation_history"
              }
            }
          }
        ]
      }
    },
    {
      "id": "google-adk.event_content_request",
      "doc": "ADK for Go writes every turn of a model request as a semantic-convention event whose `content` is the model API's whole message - `{role, parts}` - and names every non-system turn `gen_ai.user.message`, the model's own replies included. The message is read as it stands, so its stated role decides (a replayed `model` turn is the assistant's) and its parts are content blocks; the event's raw form keeps only what this reading leaves, which is no content at all. Gated on ADK's instrumentation scope, because the tag's carrier declares ADK's replay timing, and on the shape, so a `content` that is text or any other object is the event's ordinary member.",
      "source": {
        "event": {
          "names": [
            "gen_ai.system.message",
            "gen_ai.user.message"
          ]
        }
      },
      "read": {
        "attribute": "content"
      },
      "parse": "json",
      "emit": "message",
      "priority": 2010,
      "alternatives": [
        {
          "id": "content",
          "doc": "The model API's own message: a role and its parts.",
          "select": "$",
          "require": {
            "all": [
              {
                "path": "$.role",
                "kind": "string",
                "non_empty": true
              },
              {
                "path": "$.parts",
                "kind": "array"
              }
            ]
          }
        }
      ],
      "tag_as": "google_adk.request_content",
      "where": {
        "source": "scope.name",
        "equals": "gcp.vertex.agent"
      }
    },
    {
      "id": "google-adk.event_content_choice",
      "doc": "The model's answer as ADK for Go reports it: a `gen_ai.choice` whose `content` is the model API's message, with the finish reason the event states beside it. Read like the request turns, under a tag of its own because it is the call's output rather than its input.",
      "source": {
        "event": {
          "names": [
            "gen_ai.choice"
          ]
        }
      },
      "read": {
        "attribute": "content"
      },
      "parse": "json",
      "emit": "message",
      "priority": 2011,
      "alternatives": [
        {
          "id": "content",
          "doc": "The model API's own message: a role and its parts.",
          "select": "$",
          "require": {
            "all": [
              {
                "path": "$.role",
                "kind": "string",
                "non_empty": true
              },
              {
                "path": "$.parts",
                "kind": "array"
              }
            ]
          },
          "lift": [
            {
              "doc": "The reason the model stopped, which the event states beside its content.",
              "from": "carrier",
              "members": [
                "finish_reason"
              ],
              "on_conflict": "keep_target"
            }
          ]
        }
      ],
      "tag_as": "google_adk.choice_content",
      "where": {
        "source": "scope.name",
        "equals": "gcp.vertex.agent"
      }
    }
  ],
  "span_facts": [
    {
      "id": "google-adk.tool_execution",
      "doc": "A tool's response is recorded only on the span that ran it.",
      "fact": "tool_execution",
      "signals": [
        {
          "id": "agent_tool_response",
          "where": {
            "source": "attr:gcp.vertex.agent.tool_response",
            "exists": true
          }
        }
      ]
    }
  ],
  "provider_aliases": [
    {
      "doc": "This framework names itself in `gen_ai.system`, and its models are served by a provider the catalogue prices - so the value has to resolve to that provider or every one of its calls is priced from the model name alone. Declared here, in the asset that owns the framework, rather than beside the catalogue's own provider spellings.",
      "system": "google_adk",
      "provider": "gemini"
    },
    {
      "doc": "The same value with no separator, which is how one exporter writes it. Both spellings, because normalisation replaces `-` and a space with `_` rather than removing them - so this is a different value, not a variant of the one above.",
      "system": "googleadk",
      "provider": "gemini"
    }
  ]
}
