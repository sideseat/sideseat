{
  "$schema": "../../rules.schema.json",
  "id": "langchain",
  "doc": "The LangChain dialect. It also carries the shared **message fragment**: this vocabulary is how more than one framework serialises a conversation, and one dialect recognises these shapes at four different selection points, so the table lives here once rather than per point.",
  "carriers": [],
  "detect": [
    {
      "id": "langchain.detect",
      "doc": "The LangChain dialect, including the LangSmith exporter's spelling and the exact instrumentation scope emitted by the current OpenInference LangChain instrumentor. Supersedes openinference.detect because that instrumentor deliberately writes the shared openinference.* attributes alongside its framework-specific scope.",
      "label": "LangChain",
      "where": {
        "any": [
          {
            "source": "scope.name",
            "equals": "openinference.instrumentation.langchain"
          },
          {
            "source": "attr_keys",
            "starts_with": "langchain."
          },
          {
            "source": "attr_keys",
            "starts_with": "langsmith."
          }
        ]
      },
      "priority": 50,
      "supersedes": [
        "openinference.detect"
      ]
    }
  ],
  "sdk_slugs": [
    {
      "slug": "langchain",
      "label": "LangChain"
    }
  ],
  "fragments": {
    "message": {
      "doc": "What a LangChain-serialised message is. The discriminator is read from three places because the library writes it in a different one depending on how the object was constructed - the type itself, the serialisation marker, or inside the constructor's kwargs - and the content likewise, with one more home for it: `messages_to_dict` writes the type beside a `data` member that holds the rest of the message. Ordered cases: the first that recognises the shape wins.",
      "cases": [
        {
          "id": "as_user",
          "doc": "A user turn.",
          "require": {
            "any": [
              {
                "path": "$.type",
                "one_of": [
                  "human",
                  "HumanMessage"
                ]
              },
              {
                "path": "$.lc.type",
                "one_of": [
                  "human",
                  "HumanMessage"
                ]
              },
              {
                "path": "$.kwargs.type",
                "one_of": [
                  "human",
                  "HumanMessage"
                ]
              }
            ],
            "all": []
          },
          "wrap": {
            "role": "user",
            "content_from_any_of": [
              "$.content",
              "$.kwargs.content",
              "$.data.content",
              "$.text"
            ]
          }
        },
        {
          "id": "as_assistant",
          "doc": "The assistant's turn. Its tool calls may sit at the top level or under the kwargs wrapper, and an **empty** list is not a set of calls - attaching one makes a plain reply look like a call. A legacy single `function_call` is carried under its own member, and only when no `tool_calls` were found, which is the precedence the library itself uses.",
          "require": {
            "any": [
              {
                "path": "$.type",
                "one_of": [
                  "ai",
                  "AIMessage"
                ]
              },
              {
                "path": "$.lc.type",
                "one_of": [
                  "ai",
                  "AIMessage"
                ]
              },
              {
                "path": "$.kwargs.type",
                "one_of": [
                  "ai",
                  "AIMessage"
                ]
              }
            ]
          },
          "wrap": {
            "role": "assistant",
            "content_from_any_of": [
              "$.content",
              "$.kwargs.content",
              "$.data.content",
              "$.text"
            ],
            "attach": [
              {
                "as": "tool_calls",
                "from_value_any_of": [
                  "$.tool_calls",
                  "$.kwargs.tool_calls",
                  "$.data.tool_calls",
                  "$.additional_kwargs.tool_calls",
                  "$.kwargs.additional_kwargs.tool_calls",
                  "$.data.additional_kwargs.tool_calls"
                ],
                "require": {
                  "all": [
                    {
                      "kind": "array",
                      "non_empty": true
                    }
                  ]
                },
                "after_content": true
              },
              {
                "as": "function_call",
                "from_value_any_of": [
                  "$.additional_kwargs.function_call",
                  "$.kwargs.additional_kwargs.function_call",
                  "$.data.additional_kwargs.function_call"
                ],
                "after_content": true
              }
            ]
          }
        },
        {
          "id": "as_system",
          "doc": "A system turn.",
          "require": {
            "any": [
              {
                "path": "$.type",
                "one_of": [
                  "system",
                  "SystemMessage"
                ]
              },
              {
                "path": "$.lc.type",
                "one_of": [
                  "system",
                  "SystemMessage"
                ]
              },
              {
                "path": "$.kwargs.type",
                "one_of": [
                  "system",
                  "SystemMessage"
                ]
              }
            ]
          },
          "wrap": {
            "role": "system",
            "content_from_any_of": [
              "$.content",
              "$.kwargs.content",
              "$.data.content",
              "$.text"
            ]
          }
        },
        {
          "id": "as_tool",
          "doc": "A tool's reply, carrying the call id that pairs it with its call, and the tool's name.",
          "require": {
            "any": [
              {
                "path": "$.type",
                "one_of": [
                  "tool",
                  "ToolMessage"
                ]
              },
              {
                "path": "$.lc.type",
                "one_of": [
                  "tool",
                  "ToolMessage"
                ]
              },
              {
                "path": "$.kwargs.type",
                "one_of": [
                  "tool",
                  "ToolMessage"
                ]
              }
            ]
          },
          "wrap": {
            "role": "tool",
            "content_from_any_of": [
              "$.content",
              "$.kwargs.content",
              "$.data.content",
              "$.text"
            ],
            "attach": [
              {
                "as": "tool_call_id",
                "from_value_any_of": [
                  "$.tool_call_id",
                  "$.kwargs.tool_call_id",
                  "$.data.tool_call_id"
                ],
                "after_content": true
              },
              {
                "as": "name",
                "from_value_any_of": [
                  "$.name",
                  "$.kwargs.name",
                  "$.data.name"
                ],
                "after_content": true
              }
            ]
          }
        },
        {
          "id": "as_function",
          "doc": "The older function-call form. Its name defaults rather than being omitted: the shape requires one, and an absent name and an empty one are different values to anything hashing the payload.",
          "require": {
            "any": [
              {
                "path": "$.type",
                "one_of": [
                  "function",
                  "FunctionMessage"
                ]
              },
              {
                "path": "$.lc.type",
                "one_of": [
                  "function",
                  "FunctionMessage"
                ]
              },
              {
                "path": "$.kwargs.type",
                "one_of": [
                  "function",
                  "FunctionMessage"
                ]
              }
            ]
          },
          "wrap": {
            "role": "function",
            "content_from_any_of": [
              "$.content",
              "$.kwargs.content",
              "$.data.content",
              "$.text"
            ],
            "attach": [
              {
                "as": "name",
                "from_value_any_of": [
                  "$.name",
                  "$.kwargs.name",
                  "$.data.name"
                ],
                "default": "function"
              }
            ]
          }
        },
        {
          "id": "role",
          "doc": "Already in canonical form: a role and content, kept exactly as it arrived. Structural rather than rebuilt, so the provider's member order survives.",
          "require": {
            "all": [
              {
                "path": "$.role"
              },
              {
                "path": "$.content"
              }
            ]
          }
        },
        {
          "id": "role_2",
          "doc": "A role with the content somewhere else. Last, so it cannot claim a message a typed case above would have recognised.",
          "require": {
            "all": [
              {
                "path": "$.role"
              }
            ]
          },
          "wrap": {
            "role_from": "$.role",
            "content_from_any_of": [
              "$.content",
              "$.kwargs.content",
              "$.data.content",
              "$.text"
            ]
          }
        }
      ]
    }
  },
  "content_blocks": [
    {
      "id": "langchain.standard_data_block",
      "at": "after_provider_formats",
      "priority": 10,
      "doc": "LangChain's standard multimodal block: the kind as its type, the bytes inline as `base64` beside a `mime_type`, and for a document the name it was given. No provider format spells it this way, so it comes after them; a message carrying files in graph state reaches the reader in this form.",
      "require": {
        "all": [
          {
            "path": "$.type",
            "one_of": [
              "image",
              "file",
              "audio",
              "video"
            ]
          },
          {
            "path": "$.base64",
            "kind": "string",
            "non_empty": true
          },
          {
            "path": "$.mime_type",
            "kind": "string",
            "non_empty": true
          }
        ]
      },
      "media": {
        "media_type": [
          "$.mime_type"
        ],
        "data": [
          "$.base64"
        ],
        "name": [
          "$.name",
          "$.filename"
        ]
      }
    }
  ],
  "messages": [
    {
      "id": "langchain.prompt_value",
      "doc": "What a chat prompt template rendered: the messages it will send, as LangChain message dicts under `messages`. Read as messages, so the rendered system and user turns are themselves rather than one opaque structured answer of the template's.",
      "where": {
        "all": [
          {
            "source": "attr:openinference.span.kind",
            "equals_ignore_case": "prompt"
          },
          {
            "source": "scope.name",
            "equals": "openinference.instrumentation.langchain"
          }
        ]
      },
      "read": {
        "attribute": "output.value"
      },
      "parse": "json",
      "emit": "message",
      "priority": 590,
      "alternatives": [
        {
          "id": "messages",
          "doc": "The rendered conversation.",
          "select": "$.messages[*]",
          "then_fragment": "langchain.message"
        }
      ]
    }
  ]
}
