{
  "$schema": "../../rules.schema.json",
  "id": "llamaindex",
  "doc": "The LlamaIndex dialect.",
  "carriers": [],
  "detect": [
    {
      "id": "llamaindex.detect",
      "doc": "Identifies LlamaIndex by the signals below.",
      "label": "LlamaIndex",
      "where": {
        "any": [
          {
            "source": "scope.name",
            "equals": "openinference.instrumentation.llama_index"
          },
          {
            "source": "attr_keys",
            "starts_with": "llama_index."
          }
        ]
      },
      "priority": 60,
      "supersedes": [
        "openinference.detect"
      ]
    }
  ],
  "messages": [
    {
      "id": "llamaindex.chain_input",
      "doc": "LlamaIndex workflow CHAIN spans serialize Context objects and workflow events in `input.value`; model-call descendants carry the actual conversation. Claim this framework state so the generic fallback does not render it as a user turn.",
      "where": {
        "all": [
          {
            "source": "attr:openinference.span.kind",
            "equals_ignore_case": "chain"
          },
          {
            "source": "scope.name",
            "equals": "openinference.instrumentation.llama_index"
          }
        ]
      },
      "read": {
        "attribute": "input.value"
      },
      "parse": "json_or_string",
      "emit": "claim",
      "priority": 217
    },
    {
      "id": "llamaindex.chain_output",
      "doc": "A LlamaIndex workflow CHAIN output is an aggregate Python repr of AgentInput, AgentSetup, AgentOutput, ToolCallResult, or StopEvent state already represented by model and tool spans. Claim it rather than inventing assistant messages from workflow bookkeeping.",
      "where": {
        "all": [
          {
            "source": "attr:openinference.span.kind",
            "equals_ignore_case": "chain"
          },
          {
            "source": "scope.name",
            "equals": "openinference.instrumentation.llama_index"
          }
        ]
      },
      "read": {
        "attribute": "output.value"
      },
      "parse": "json_or_string",
      "emit": "claim",
      "priority": 218
    },
    {
      "id": "llamaindex.prepare_chat_input",
      "doc": "The private `_prepare_chat_with_tools` helper of an LLM class (OpenAI, BedrockConverse) serializes the same request that its `achat` or `astream_chat` sibling on the same LLM class sends. Claim the helper input so only the actual model invocation contributes conversation messages.",
      "where": {
        "all": [
          {
            "source": "span_name",
            "one_of": [
              "OpenAI._prepare_chat_with_tools",
              "BedrockConverse._prepare_chat_with_tools"
            ]
          },
          {
            "source": "scope.name",
            "equals": "openinference.instrumentation.llama_index"
          }
        ]
      },
      "read": {
        "attribute": "input.value"
      },
      "parse": "json_or_string",
      "emit": "claim",
      "priority": 219
    },
    {
      "id": "llamaindex.prepare_chat_output",
      "doc": "The private `_prepare_chat_with_tools` result is a second serialization of the model invocation's messages and tools. Claim it so the generic fallback cannot expose transport preparation as an assistant JSON block.",
      "where": {
        "all": [
          {
            "source": "span_name",
            "one_of": [
              "OpenAI._prepare_chat_with_tools",
              "BedrockConverse._prepare_chat_with_tools"
            ]
          },
          {
            "source": "scope.name",
            "equals": "openinference.instrumentation.llama_index"
          }
        ]
      },
      "read": {
        "attribute": "output.value"
      },
      "parse": "json_or_string",
      "emit": "claim",
      "priority": 221
    }
  ],
  "sdk_slugs": [
    {
      "slug": "llama-index",
      "label": "LlamaIndex"
    }
  ]
}
