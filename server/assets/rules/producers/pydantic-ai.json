{
  "$schema": "../../rules.schema.json",
  "id": "pydantic-ai",
  "doc": "The pydantic-ai dialect.",
  "carriers": [
    {
      "id": "pydantic-ai.all_messages",
      "doc": "The whole conversation as this dialect reports it.",
      "match": {
        "attribute": "pydantic_ai.all_messages"
      },
      "facts": {
        "preset": "snapshot",
        "carrier_holds_span_input": true,
        "carrier_holds_expandable_message_array": true
      }
    }
  ],
  "messages": [
    {
      "id": "pydantic-ai.tool_arguments",
      "doc": "The arguments a tool was called with. A bare payload rather than a message, so the role it represents is declared beside the carrier. Parsed with a string fallback: these values are not always JSON, and dropping an unparseable one would lose the call.",
      "read": {
        "attribute": "tool_arguments"
      },
      "parse": "json_or_string",
      "emit": "message",
      "priority": 1100,
      "wrap": {
        "role": "tool_call"
      }
    },
    {
      "id": "pydantic-ai.tool_response",
      "doc": "What the tool returned, under the same reading.",
      "read": {
        "attribute": "tool_response"
      },
      "parse": "json_or_string",
      "emit": "message",
      "priority": 1110,
      "wrap": {
        "role": "tool"
      }
    }
  ],
  "content_blocks": [
    {
      "id": "pydantic-ai.tool_call_response",
      "doc": "This dialect writes a tool's return value under `result` rather than the conventions' `response`. The provider formats read only `response`, so a result no tool span restated - the output tool's acknowledgement, which ends the run - rendered as an empty result with no name.",
      "at": "before_provider_formats",
      "priority": 70,
      "where": {
        "all": [
          {
            "path": "$.type",
            "one_of": [
              "tool_call_response"
            ]
          },
          {
            "path": "$.result",
            "exists": true
          }
        ]
      },
      "tool_result": {
        "tool_use_id": [
          "$.id"
        ],
        "name": [
          "$.name"
        ],
        "content": [
          "$.result"
        ]
      }
    },
    {
      "id": "pydantic-ai.thinking_content",
      "at": "provider_formats",
      "priority": 1953,
      "where": {
        "all": [
          {
            "path": "$.type",
            "one_of": [
              "thinking"
            ]
          },
          {
            "path": "$.content",
            "kind": "string"
          }
        ]
      },
      "thinking": {
        "text": [
          "$.content"
        ],
        "signature": [
          "$.signature"
        ],
        "doc": "A thinking part with its reasoning under `content`."
      }
    }
  ]
}
