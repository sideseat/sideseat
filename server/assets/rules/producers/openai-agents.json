{
  "$schema": "../../rules.schema.json",
  "id": "openai-agents",
  "doc": "The OpenAIAgents dialect.",
  "carriers": [],
  "detect": [
    {
      "id": "openai-agents.detect",
      "doc": "Identifies OpenAIAgents by its own scope and attribute namespace. Logfire's instrumentation records the SDK's spans under its own `logfire.openai_agents` scope and with Logfire's attributes, so the scope is the evidence that the spans describe this framework rather than Logfire itself: placed ahead of Logfire's detection, and the overlap is declared rather than left to priority.",
      "label": "OpenAIAgents",
      "where": {
        "any": [
          {
            "source": "scope.name",
            "equals": "logfire.openai_agents"
          },
          {
            "source": "attr_keys",
            "starts_with": "openai.agents."
          }
        ]
      },
      "priority": 195,
      "supersedes": [
        "logfire.detect"
      ],
      "alternatives": [
        {
          "id": "openai-agents.detect.service_name_under_logfire",
          "doc": "The SDK's default service name on a span Logfire's instrumentation wrote. Logfire records the SDK's run-level spans without its `logfire.openai_agents` scope, so there the service name is the evidence that they describe this framework; ahead of Logfire's own detection for that reason, and only together with Logfire's signals, because on its own a service name is weak.",
          "priority": 196,
          "supersedes": [
            "logfire.detect"
          ],
          "where": {
            "all": [
              {
                "any": [
                  {
                    "source": "resource:service.name",
                    "contains": "openai-agents"
                  },
                  {
                    "source": "resource:service.name",
                    "contains": "openai_agents"
                  }
                ]
              },
              {
                "any": [
                  {
                    "source": "attr_keys",
                    "starts_with": "logfire."
                  },
                  {
                    "source": "resource:telemetry.sdk.name",
                    "contains": "logfire"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "openai-agents.detect.service_name",
          "doc": "The service names the SDK reports by default, on their own. Weak evidence - a user names their own service - so it sits behind every instrumentation library's own signal.",
          "priority": 240,
          "where": {
            "any": [
              {
                "source": "resource:service.name",
                "contains": "openai-agents"
              },
              {
                "source": "resource:service.name",
                "contains": "openai_agents"
              }
            ]
          }
        }
      ]
    }
  ],
  "sdk_slugs": [
    {
      "slug": "openai-agents",
      "label": "OpenAIAgents"
    }
  ],
  "messages": [
    {
      "id": "openai-agents.function_input",
      "doc": "The OpenAI Agents SDK records a local function execution as a Logfire span with the callable name and its JSON input. It carries no semantic-convention call id, so the name and arguments are retained and query-time correlation joins it to the oldest unmatched model call of that name.",
      "read": {
        "attribute": "input"
      },
      "parse": "json_or_string",
      "wrap": {
        "role": "assistant",
        "block": {
          "type": "tool_use",
          "content_as": "input",
          "attach": [
            {
              "from": "name",
              "as": "name"
            }
          ]
        }
      },
      "emit": "message",
      "where": {
        "source": "attr:logfire.msg_template",
        "equals": "Function: {name}"
      },
      "priority": 1380,
      "reads_tool_spans": true
    },
    {
      "id": "openai-agents.function_output",
      "doc": "The return value on the same local function span. Keeping the execution span's own result closes the tool call/result pair even though the next model request also replays that result as history.",
      "read": {
        "attribute": "output"
      },
      "parse": "json_or_string",
      "wrap": {
        "role": "tool",
        "block": {
          "type": "tool_result",
          "attach": [
            {
              "from": "name",
              "as": "name"
            }
          ]
        }
      },
      "emit": "message",
      "where": {
        "source": "attr:logfire.msg_template",
        "equals": "Function: {name}"
      },
      "priority": 1390,
      "reads_tool_spans": true
    },
    {
      "id": "openai-agents.response_tools",
      "doc": "The whole API response is recorded, and the tools it was called with are inside it.",
      "read": {
        "attribute": "response"
      },
      "parse": "json",
      "emit": "tool_definitions",
      "require_non_empty": true,
      "alternatives": [
        {
          "id": "tools",
          "select": "$.tools",
          "require": {
            "all": [
              {
                "kind": "array"
              },
              {
                "non_empty": true
              }
            ]
          }
        }
      ],
      "priority": 1350
    }
  ],
  "span_facts": [
    {
      "id": "openai-agents.function_execution",
      "doc": "The SDK's local function span uses Logfire's stable template and carries the callable name plus both sides of the execution.",
      "fact": "tool_execution",
      "signals": [
        {
          "id": "logfire_function",
          "where": {
            "all": [
              {
                "source": "attr:logfire.msg_template",
                "equals": "Function: {name}"
              },
              {
                "source": "attr:name",
                "exists": true
              },
              {
                "source": "attr:input",
                "exists": true
              },
              {
                "source": "attr:output",
                "exists": true
              }
            ]
          }
        }
      ]
    }
  ]
}
