{
  "$schema": "../../rules.schema.json",
  "id": "crewai",
  "doc": "The CrewAI dialect.",
  "carriers": [],
  "detect": [
    {
      "id": "crewai.detect",
      "doc": "CrewAI writes its own identifiers onto the span, and its telemetry service reports a distinctive name.",
      "label": "CrewAI",
      "where": {
        "any": [
          {
            "source": "attr:crewai_version",
            "exists": true
          },
          {
            "source": "attr:crew_key",
            "exists": true
          },
          {
            "source": "attr:crew_id",
            "exists": true
          },
          {
            "source": "attr:crew_fingerprint",
            "exists": true
          },
          {
            "source": "attr:task_key",
            "exists": true
          },
          {
            "source": "resource:service.name",
            "contains": "crewAI-telemetry"
          }
        ]
      },
      "priority": 30
    }
  ],
  "sdk_slugs": [
    {
      "slug": "crewai",
      "label": "CrewAI"
    }
  ],
  "messages": [
    {
      "id": "crewai.crew_tasks",
      "doc": "The crew's task definitions, kept whole.",
      "where": {
        "any": [
          {
            "source": "attr:crew_key",
            "exists": true
          },
          {
            "source": "attr:crew_id",
            "exists": true
          },
          {
            "source": "attr:crew_tasks",
            "exists": true
          },
          {
            "source": "attr:task_key",
            "exists": true
          }
        ]
      },
      "read": {
        "attribute": "crew_tasks"
      },
      "parse": "json",
      "emit": "message",
      "priority": 1500
    },
    {
      "id": "crewai.output",
      "doc": "One payload holding the history *and* the answer. The readings are cumulative, not alternatives: the turns live under `messages` (and under each task's own `messages`) while the answer itself is the top-level `raw`, so reading them as alternatives dropped the assistant output of every run that carried history - `crewai/reasoning` recorded three user turns and no answer, and the goldens recorded that as correct because no invariant requires an answer to exist. A turn must look like one (a role, and content or tool calls) so a task's other members are not mistaken for turns. The fallback keeps an unrecognised payload whole rather than leaving the span silently empty.",
      "where": {
        "any": [
          {
            "source": "attr:crew_key",
            "exists": true
          },
          {
            "source": "attr:crew_id",
            "exists": true
          },
          {
            "source": "attr:crew_tasks",
            "exists": true
          },
          {
            "source": "attr:task_key",
            "exists": true
          }
        ]
      },
      "read": {
        "attribute": "output.value"
      },
      "parse": "json",
      "emit": "message",
      "priority": 1510,
      "also": [
        {
          "id": "request",
          "doc": "The turns the run was given - its instructions and the task it was asked - written into its output beside what it did with them. The request, whatever carrier holds it.",
          "select": "$.messages[*]",
          "direction": "input",
          "where": {
            "all": [
              {
                "path": "$.role",
                "one_of": ["system", "user"]
              },
              {
                "any": [
                  {
                    "path": "$.content"
                  },
                  {
                    "path": "$.tool_calls"
                  },
                  {
                    "path": "$.toolCalls"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "messages",
          "doc": "The rest of the conversation's turns: what the run did - the model's calls and the results it was given back - which are its output, as the carrier says.",
          "select": "$.messages[*]",
          "where": {
            "all": [
              {
                "path": "$.role",
                "none_of": ["system", "user"],
                "exists": true
              },
              {
                "any": [
                  {
                    "path": "$.content"
                  },
                  {
                    "path": "$.tool_calls"
                  },
                  {
                    "path": "$.toolCalls"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "messages_2",
          "doc": "And each task's own turns, as the crew's output lists them again. A rendering: each task's own span carries them losslessly, so the crew's copy is shown on the crew's span and left out of the trace and session views. Read there, the crew's copy placed every task's answer at the crew's end, after the request of the task that followed it.",
          "select": "$.tasks_output[*].messages[*]",
          "rendering": {"path": "$.role"},
          "where": {
            "all": [
              {
                "path": "$.role"
              },
              {
                "any": [
                  {
                    "path": "$.content"
                  },
                  {
                    "path": "$.tool_calls"
                  },
                  {
                    "path": "$.toolCalls"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "raw",
          "doc": "The answer, which is a bare string beside them and so needs its own envelope.",
          "select": "$.raw",
          "pipe": ["trim"],
          "where": {
            "kind": "string",
            "non_empty": true
          },
          "wrap": {
            "role": "assistant"
          }
        }
      ],
      "fallback": [
        {
          "id": "no_documented_shape_matched",
          "doc": "No documented shape matched: keep the payload rather than nothing."
        }
      ]
    },
    {
      "id": "crewai.agent_task_tools",
      "doc": "The tools this dialect names in its agent and task metadata. An entry may be a tool itself or hold a list of them, and the same tool appears under both keys at different richness - so every carrier is read and the best copy per name wins.",
      "read": {
        "every": [
          "crew_agents",
          "crew_tasks"
        ]
      },
      "emit": "tool_definitions",
      "parse": "json",
      "where": {
        "any": [
          {
            "source": "attr:crew_key",
            "exists": true
          },
          {
            "source": "attr:crew_id",
            "exists": true
          },
          {
            "source": "attr:crew_tasks",
            "exists": true
          },
          {
            "source": "attr:task_key",
            "exists": true
          },
          {
            "source": "attr:crew_agents",
            "exists": true
          }
        ]
      },
      "tool_repr": {
        "name_field": "name",
        "description_field": "description",
        "name_label": "Tool Name:",
        "description_label": "Tool Description:",
        "arguments_label": "Tool Arguments:",
        "repr_markers": [
          "name=",
          "Tool Name:",
          "CrewStructuredTool("
        ],
        "parameter_members": [
          "parameters",
          "input_schema",
          "args",
          "arguments",
          "tool_args",
          "tool_arguments"
        ],
        "type_map": [
          [
            "str",
            "string"
          ],
          [
            "string",
            "string"
          ],
          [
            "int",
            "integer"
          ],
          [
            "integer",
            "integer"
          ],
          [
            "float",
            "number"
          ],
          [
            "double",
            "number"
          ],
          [
            "number",
            "number"
          ],
          [
            "bool",
            "boolean"
          ],
          [
            "boolean",
            "boolean"
          ],
          [
            "list",
            "array"
          ],
          [
            "array",
            "array"
          ],
          [
            "dict",
            "object"
          ],
          [
            "object",
            "object"
          ]
        ],
        "type_default": {
          "map_to": "string"
        },
        "doc": "An array of agent or task entries.",
        "entries": "$[*]",
        "candidates": [
          "$",
          "$.tools_names[*]",
          "$.tools[*]"
        ],
        "field_terminators": [
          "env_vars",
          "args_schema"
        ]
      },
      "priority": 1520
    },
    {
      "id": "crewai.input_value_tools",
      "doc": "The richer copy: this dialect logs its tool objects' `repr` here, with the arguments schema and the documentation embedded in a labelled string.",
      "read": {
        "attribute": "input.value"
      },
      "emit": "tool_definitions",
      "parse": "json",
      "where": {
        "any": [
          {
            "source": "attr:crew_key",
            "exists": true
          },
          {
            "source": "attr:crew_id",
            "exists": true
          },
          {
            "source": "attr:crew_tasks",
            "exists": true
          },
          {
            "source": "attr:task_key",
            "exists": true
          },
          {
            "source": "attr:crew_agents",
            "exists": true
          }
        ]
      },
      "tool_repr": {
        "name_field": "name",
        "description_field": "description",
        "name_label": "Tool Name:",
        "description_label": "Tool Description:",
        "arguments_label": "Tool Arguments:",
        "repr_markers": [
          "name=",
          "Tool Name:",
          "CrewStructuredTool("
        ],
        "parameter_members": [
          "parameters",
          "input_schema",
          "args",
          "arguments",
          "tool_args",
          "tool_arguments"
        ],
        "type_map": [
          [
            "str",
            "string"
          ],
          [
            "string",
            "string"
          ],
          [
            "int",
            "integer"
          ],
          [
            "integer",
            "integer"
          ],
          [
            "float",
            "number"
          ],
          [
            "double",
            "number"
          ],
          [
            "number",
            "number"
          ],
          [
            "bool",
            "boolean"
          ],
          [
            "boolean",
            "boolean"
          ],
          [
            "list",
            "array"
          ],
          [
            "array",
            "array"
          ],
          [
            "dict",
            "object"
          ],
          [
            "object",
            "object"
          ]
        ],
        "type_default": {
          "map_to": "string"
        },
        "doc": "One object holding a list of tools, a single tool, or both.",
        "entries": "$",
        "candidates": [
          "$.tools[*]",
          "$.tools",
          "$.tool"
        ],
        "field_terminators": [
          "env_vars",
          "args_schema"
        ]
      },
      "priority": 1530
    },
    {
      "id": "crewai.aggregate_input",
      "doc": "On a Crew span, `input.value` may be the framework's own state - agents, tasks, tool `repr` - with no conversation. The tools are read on the metadata axis; claimed here so the repr is not shown as a turn. A populated conversation member (`context`, `messages`) must not be swallowed, but CrewAI also writes an empty `context` beside its agent snapshot and an empty tool list. That is still metadata: treating the empty wrappers as a turn leaked the entire agent configuration into `crewai/error`.",
      "read": {
        "attribute": "input.value"
      },
      "parse": "json",
      "where": {
        "any": [
          {
            "source": "attr:crew_key",
            "exists": true
          },
          {
            "source": "attr:crew_id",
            "exists": true
          },
          {
            "source": "attr:crew_tasks",
            "exists": true
          },
          {
            "source": "attr:task_key",
            "exists": true
          },
          {
            "source": "attr:crew_agents",
            "exists": true
          }
        ]
      },
      "emit": "claim",
      "alternatives": [
        {
          "id": "context",
          "doc": "Only where the tool list is what it holds. A populated `context` or `messages` member is a conversation and keeps the carrier available to message readers.",
          "where": {
            "all": [
              {
                "path": "$.context",
                "exists": false,
                "doc": "The conversation, where this carrier has one."
              },
              {
                "path": "$.messages",
                "exists": false,
                "doc": "A conversation under its other name - CrewAI-through-LangGraph writes `messages`. Claiming a carrier that has one would take the turn away, which `crewai/error` already proved for `context`."
              },
              {
                "any": [
                  {
                    "path": "$.tools",
                    "non_empty": true
                  },
                  {
                    "path": "$.tool",
                    "exists": true
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "empty_agent_snapshot",
          "doc": "CrewAI's agent execution envelope with no context is configuration metadata even when it declares zero tools. The agent object is the discriminator; a non-empty context or a messages member remains a conversation.",
          "where": {
            "all": [
              {
                "path": "$.agent",
                "kind": "object"
              },
              {
                "path": "$.context",
                "one_of": [
                  ""
                ]
              },
              {
                "path": "$.messages",
                "exists": false
              }
            ]
          }
        }
      ],
      "priority": 1515
    },
    {
      "id": "crewai.flow_node_output",
      "doc": "CrewAI runs its agent executor as a Flow (`crewai.experimental.agent_executor.AgentExecutor`), and openinference-instrumentation-crewai 1.1.3 and 1.1.7 trace it: a kickoff span and one CHAIN span per flow method, whose output.value is the label the method hands back to the flow - the route a router picks next (`check_iteration`, `native_tool_calls`) or a state marker (`initialized`). The executor marks itself `suppress_flow_events`, which later releases of the instrumentor honour. The labels steer the flow and say nothing to anyone; the model calls and tool runs beneath them carry the conversation. Claimed only where the span is one of the executor's own methods and the output one of its labels, so a user's Flow keeps what its methods return.",
      "where": {
        "all": [
          {
            "source": "attr:openinference.span.kind",
            "equals_ignore_case": "chain"
          },
          {
            "source": "scope.name",
            "equals": "openinference.instrumentation.crewai"
          },
          {
            "source": "attr:flow.node.name",
            "one_of": [
              "after_parallel_execution",
              "call_llm_and_parse",
              "call_llm_native_tools",
              "check_max_iterations",
              "check_more_todos",
              "check_native_todo_completion",
              "check_todo_completion",
              "check_todos_available",
              "continue_iteration",
              "decide_next_action",
              "ensure_force_final_answer",
              "execute_native_tool",
              "execute_todo_sequential",
              "execute_todos_parallel",
              "execute_tool_action",
              "finalize",
              "generate_plan",
              "get_ready_todos_method",
              "handle_continue_plan",
              "handle_goal_achieved",
              "handle_refine_and_continue",
              "handle_replan",
              "handle_replan_now",
              "handle_step_observed_low",
              "handle_step_observed_medium",
              "increment_and_continue",
              "initialize_reasoning",
              "mark_todo_complete",
              "observe_step_result",
              "recover_from_context_length",
              "recover_from_parser_error",
              "route_by_answer_type"
            ],
            "doc": "The executor's flow methods (its `@start`, `@listen` and `@router` methods in agent_executor.py)."
          }
        ]
      },
      "read": {
        "attribute": "output.value"
      },
      "parse": "json_or_string",
      "emit": "claim",
      "alternatives": [
        {
          "id": "executor_label",
          "doc": "The labels the executor's methods return in CrewAI 1.15 (`return \"...\"` in agent_executor.py).",
          "where": {
            "kind": "string",
            "one_of": [
              "agent_finished",
              "all_todos_complete",
              "check_iteration",
              "completed",
              "context_error",
              "continue_plan",
              "continue_reasoning",
              "continue_reasoning_native",
              "execute_tool",
              "force_final_answer",
              "goal_achieved",
              "has_todos",
              "initialized",
              "medium",
              "multiple_todos_ready",
              "native_finished",
              "native_tool_calls",
              "native_tool_completed",
              "needs_replan",
              "no_todos",
              "parallel_todos_complete",
              "parsed",
              "parser_error",
              "planning_disabled",
              "refine_and_continue",
              "replan_now",
              "single_todo_ready",
              "skipped",
              "step_executed",
              "step_observed_high",
              "step_observed_low",
              "step_observed_medium",
              "todo_injected",
              "todo_marked",
              "todo_not_satisfied",
              "todo_satisfied",
              "tool_completed",
              "tool_result_is_final",
              "unknown"
            ]
          }
        }
      ],
      "priority": 1516
    },
    {
      "id": "crewai.flow_kickoff_output",
      "doc": "The executor flow's kickoff, which reports the label its last method returned (`completed`). A kickoff names no method, so the executor's is told apart by what it was given: it is started with no inputs. Claimed only for one of the executor's labels; a user's Flow started with inputs, or returning anything else, keeps its answer.",
      "where": {
        "all": [
          {
            "source": "attr:openinference.span.kind",
            "equals_ignore_case": "chain"
          },
          {
            "source": "scope.name",
            "equals": "openinference.instrumentation.crewai"
          },
          {
            "source": "attr:flow_id",
            "exists": true
          },
          {
            "source": "attr:flow_inputs",
            "equals": ""
          }
        ]
      },
      "read": {
        "attribute": "output.value"
      },
      "parse": "json_or_string",
      "emit": "claim",
      "alternatives": [
        {
          "id": "executor_label",
          "doc": "The labels the executor's methods return in CrewAI 1.15 (`return \"...\"` in agent_executor.py).",
          "where": {
            "kind": "string",
            "one_of": [
              "agent_finished",
              "all_todos_complete",
              "check_iteration",
              "completed",
              "context_error",
              "continue_plan",
              "continue_reasoning",
              "continue_reasoning_native",
              "execute_tool",
              "force_final_answer",
              "goal_achieved",
              "has_todos",
              "initialized",
              "medium",
              "multiple_todos_ready",
              "native_finished",
              "native_tool_calls",
              "native_tool_completed",
              "needs_replan",
              "no_todos",
              "parallel_todos_complete",
              "parsed",
              "parser_error",
              "planning_disabled",
              "refine_and_continue",
              "replan_now",
              "single_todo_ready",
              "skipped",
              "step_executed",
              "step_observed_high",
              "step_observed_low",
              "step_observed_medium",
              "todo_injected",
              "todo_marked",
              "todo_not_satisfied",
              "todo_satisfied",
              "tool_completed",
              "tool_result_is_final",
              "unknown"
            ]
          }
        }
      ],
      "priority": 1517
    }
  ]
}
