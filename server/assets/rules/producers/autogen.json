{
  "$schema": "../../rules.schema.json",
  "id": "autogen",
  "doc": "The AutoGen dialect. Its messages arrive as typed objects - a type name per shape - which is why the table below is a fragment: the same vocabulary is written at five different selection points.",
  "carriers": [
    {
      "id": "autogen.logged_messages",
      "doc": "The request a logged model call was sent, as the provider's own chat messages: a conversation re-listed in order on every call, so a repeat inside it restates an earlier turn rather than being a second one.",
      "match": {
        "event": "messages"
      },
      "facts": {
        "preset": "snapshot",
        "carrier_holds_span_input": true,
        "carrier_holds_expandable_message_array": true
      }
    },
    {
      "id": "autogen.logged_response",
      "doc": "The provider's response object on the same event: what the model produced, each choice an emission of its own.",
      "match": {
        "event": "response"
      },
      "facts": {
        "preset": "emission"
      }
    }
  ],
  "detect": [
    {
      "id": "autogen.detect",
      "doc": "OpenInference's AutoGen instrumentation sets gen_ai.system while service.name may still be the default, so the system value is a signal in its own right.",
      "label": "AutoGen",
      "where": {
        "any": [
          {
            "source": "span_name",
            "starts_with": "autogen "
          },
          {
            "source": "span_name",
            "starts_with": "autogen."
          },
          {
            "source": "attr_keys",
            "starts_with": "autogen."
          },
          {
            "source": "attr:gen_ai.system",
            "equals": "autogen"
          }
        ]
      },
      "priority": 10
    }
  ],
  "sdk_slugs": [
    {
      "slug": "autogen",
      "label": "AutoGen"
    }
  ],
  "messages": [
    {
      "id": "autogen.aggregate_input",
      "doc": "An agent span's `input.value` holds a Python `repr` of framework internals - a cancellation token, a flag - rather than a conversation; the messages come from its children. Claimed so a generic reader does not present that text as one, and read for nothing.",
      "read": {
        "attribute": "input.value"
      },
      "parse": "json",
      "emit": "claim",
      "priority": 1600,
      "alternatives": [
        {
          "id": "cancellation_token",
          "doc": "Read for nothing; the claim is the whole effect.",
          "where": {
            "any": [
              {
                "path": "$.cancellation_token",
                "exists": true
              },
              {
                "path": "$.output_task_messages",
                "exists": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": "autogen.logged_request",
      "doc": "The request a logged model call was sent: the provider's own chat messages, each read as the message it is. The event's members arrive as its attributes, so this reads `messages` exactly as a span attribute holding the same array would be read.",
      "source": {
        "event": {
          "names": [
            "LLMCall",
            "LLMStreamStart"
          ]
        }
      },
      "read": {
        "attribute": "messages"
      },
      "parse": "json",
      "emit": "message",
      "priority": 1340,
      "alternatives": [
        {
          "id": "messages",
          "doc": "One message per element, in the order the request held them.",
          "select": "$",
          "each": true,
          "where": {
            "path": "$.role",
            "exists": true
          }
        }
      ]
    },
    {
      "id": "autogen.logged_response",
      "doc": "What the model answered, from the provider's response object the event carries: its choices' messages, which the OpenAI vocabulary reads whole - text, refusals and tool calls alike.",
      "source": {
        "event": {
          "names": [
            "LLMCall",
            "LLMStreamEnd"
          ]
        }
      },
      "read": {
        "attribute": "response"
      },
      "parse": "json",
      "emit": "message",
      "priority": 1341,
      "alternatives": [
        {
          "id": "choices",
          "doc": "One message per choice.",
          "select": "$.choices",
          "each": true,
          "descend": "message",
          "lift": [
            {
              "from": "parent",
              "members": [
                "finish_reason"
              ],
              "on_conflict": "keep_target"
            }
          ]
        }
      ]
    },
    {
      "id": "autogen.logged_tool_run",
      "doc": "A tool this dialect ran, logged as one event holding the name, the arguments and the value returned. Claimed rather than read: a request of the same conversation re-sends both sides - the call under the id the provider gave it, and the result against that id - so reading this copy too would show each twice, and this one carries no id to collapse them by. Claimed so the record is accounted for rather than left looking like a conversation nothing read.\n\nThe corpus shows no result this loses: the dialect logs a request even for a turn that ends on a tool result, since its agent asks the model again before stopping (`trailing_tool`). A dialect that stopped without that request would carry its last result only here, and reading it would then need the call id binding this copy lacks.",
      "source": {
        "event": {
          "names": [
            "ToolCall"
          ]
        }
      },
      "read": {
        "attribute": "tool_name"
      },
      "parse": "text",
      "raw_where": {
        "non_blank": true
      },
      "emit": "claim",
      "priority": 1342
    },
    {
      "id": "autogen.message",
      "doc": "The dialect's message carrier. It holds a typed message, a list of them, one nested under `message`, or a response with its reply and the inner turns that produced it - so the shapes are ordered and the first that fits is read.",
      "read": {
        "attribute": "message"
      },
      "parse": "json",
      "where": {
        "not": {
          "source": "attr:message",
          "exists": true,
          "one_of": [
            "No Message",
            "{}"
          ]
        }
      },
      "alternatives": [
        {
          "id": "message",
          "doc": "The attribute is the message.",
          "then_fragment": "autogen.message"
        },
        {
          "id": "messages",
          "doc": "A list of them.",
          "select": "$.messages",
          "each": true,
          "then_fragment": "autogen.message",
          "extra_cases": [
            {
              "id": "content",
              "doc": "A shape the table refused that still carries content - read here rather than dropped.",
              "where": {
                "path": "$.content",
                "exists": true
              }
            }
          ]
        },
        {
          "id": "message_2",
          "doc": "One nested under `message`.",
          "select": "$.message",
          "then_fragment": "autogen.message",
          "extra_cases": [
            {
              "id": "content_2",
              "doc": "A shape the table refused that still carries content - read here rather than dropped.",
              "where": {
                "path": "$.content",
                "exists": true
              }
            }
          ]
        },
        {
          "id": "chat_message",
          "doc": "A response's own reply.",
          "select": "$.response.chat_message",
          "then_fragment": "autogen.message"
        },
        {
          "id": "content_3",
          "doc": "Neither, but message-shaped.",
          "where": {
            "all": [
              {
                "kind": "object"
              },
              {
                "any": [
                  {
                    "path": "$.content",
                    "exists": true
                  },
                  {
                    "path": "$.role",
                    "exists": true
                  }
                ]
              }
            ]
          }
        }
      ],
      "priority": 1610,
      "also": [
        {
          "id": "inner_messages",
          "doc": "The turns inside a response, after its reply. Additive rather than ordered: a response carries both.",
          "select": "$.response.inner_messages",
          "each": true,
          "then_fragment": "autogen.message"
        }
      ]
    }
  ],
  "message_events": [
    {
      "id": "autogen.message_event.llm_call",
      "name": "LLMCall",
      "doc": "This dialect's structured event for a complete model call: the request's messages and the provider's response in one record. A container - its readings are the conversation, so emitting the record itself would report the whole event as one message.",
      "raw": "replace"
    },
    {
      "id": "autogen.message_event.llm_stream_start",
      "name": "LLMStreamStart",
      "doc": "The request of a streamed call, logged before the stream opens; its response arrives as `LLMStreamEnd`.",
      "raw": "replace"
    },
    {
      "id": "autogen.message_event.llm_stream_end",
      "name": "LLMStreamEnd",
      "doc": "The response of a streamed call. It carries no messages, because the request was logged as `LLMStreamStart`.",
      "raw": "replace"
    },
    {
      "id": "autogen.message_event.tool_call",
      "name": "ToolCall",
      "doc": "A tool this dialect ran, with the arguments it was given and the value it returned.",
      "raw": "replace"
    }
  ],
  "log_events": [
    {
      "id": "autogen.log_event.llm_call",
      "name": "LLMCall",
      "name_from": "body:type",
      "payload": "body_members",
      "doc": "This dialect logs each event through Python's `logging`, so a record's body is the event's JSON and its `type` member is the only place the kind is written - the record carries no `event_name` field and no attribute holding one."
    },
    {
      "id": "autogen.log_event.llm_stream_start",
      "name": "LLMStreamStart",
      "name_from": "body:type",
      "payload": "body_members",
      "doc": "As `LLMCall`."
    },
    {
      "id": "autogen.log_event.llm_stream_end",
      "name": "LLMStreamEnd",
      "name_from": "body:type",
      "payload": "body_members",
      "doc": "As `LLMCall`."
    },
    {
      "id": "autogen.log_event.tool_call",
      "name": "ToolCall",
      "name_from": "body:type",
      "payload": "body_members",
      "doc": "As `LLMCall`."
    }
  ],
  "fragments": {
    "message": {
      "doc": "What an AutoGen message is. The discriminator is the `type` member; a value the table does not know is passed through rather than dropped, and an untyped object is recognised by its shape. Ordered cases: the first that fits wins.",
      "cases": [
        {
          "id": "as_system",
          "doc": "A system instruction.",
          "where": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "SystemMessage"
                ]
              },
              {
                "path": "$.content",
                "exists": true
              }
            ]
          },
          "wrap": {
            "role": "system",
            "content_from": "$.content"
          }
        },
        {
          "id": "as_user",
          "doc": "A user turn addressed to the model.",
          "where": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "UserMessage"
                ]
              },
              {
                "path": "$.content",
                "exists": true
              }
            ]
          },
          "wrap": {
            "role": "user",
            "attach": [
              {
                "from_value": "$.source",
                "after_content": true,
                "as": "name"
              }
            ],
            "content_from": "$.content"
          }
        },
        {
          "id": "as_assistant",
          "doc": "The model's reply. Reasoning arrives in a sibling member and becomes a thinking block ahead of the text, so the two are one turn rather than two messages.",
          "where": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "AssistantMessage"
                ]
              },
              {
                "path": "$.content",
                "exists": true
              }
            ]
          },
          "wrap": {
            "role": "assistant",
            "attach": [
              {
                "from_value": "$.source",
                "as": "name"
              }
            ],
            "prepend_block": {
              "from": "$.thought",
              "where": {
                "all": [
                  {
                    "not_null": true
                  },
                  {
                    "non_empty": true
                  }
                ]
              },
              "block": {
                "type": "thinking",
                "content_as": "text",
                "attach": [
                  {
                    "value": null,
                    "after_content": true,
                    "as": "signature"
                  }
                ]
              }
            },
            "content_from": "$.content"
          }
        },
        {
          "id": "as_assistant_2",
          "where": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "TextMessage"
                ]
              },
              {
                "path": "$.content",
                "exists": true
              }
            ]
          },
          "wrap": {
            "role_from": {
              "path": "$.source",
              "pipe": [{"map": {"user": "user"}, "closed": true}]
            },
            "role": "assistant",
            "attach": [
              {
                "from_value": "$.source",
                "where": {
                  "none_of": [
                    "user"
                  ]
                },
                "after_content": true,
                "as": "name"
              }
            ],
            "content_from": "$.content"
          },
          "doc": "An agent's utterance; `source` names the speaker."
        },
        {
          "id": "as_assistant_3",
          "where": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "MultiModalMessage"
                ]
              },
              {
                "path": "$.content",
                "exists": true
              }
            ]
          },
          "wrap": {
            "role_from": {
              "path": "$.source",
              "pipe": [{"map": {"user": "user"}, "closed": true}]
            },
            "role": "assistant",
            "attach": [
              {
                "from_value": "$.source",
                "where": {
                  "none_of": [
                    "user"
                  ]
                },
                "after_content": true,
                "as": "name"
              }
            ],
            "content_from": "$.content"
          },
          "doc": "An utterance carrying images beside its text."
        },
        {
          "id": "as_assistant_4",
          "where": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "StopMessage"
                ]
              },
              {
                "path": "$.content",
                "exists": true
              }
            ]
          },
          "wrap": {
            "role_from": {
              "path": "$.source",
              "pipe": [{"map": {"user": "user"}, "closed": true}]
            },
            "role": "assistant",
            "attach": [
              {
                "from_value": "$.source",
                "where": {
                  "none_of": [
                    "user"
                  ]
                },
                "after_content": true,
                "as": "name"
              }
            ],
            "content_from": "$.content"
          },
          "doc": "The utterance that ended a conversation."
        },
        {
          "id": "as_assistant_5",
          "doc": "One agent handing the conversation to another.",
          "where": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "HandoffMessage"
                ]
              },
              {
                "path": "$.content",
                "exists": true
              }
            ]
          },
          "wrap": {
            "role": "assistant",
            "attach": [
              {
                "from_value": "$.source",
                "after_content": true,
                "where": {
                  "kind": "string"
                },
                "as": "name"
              }
            ],
            "content_from": "$.content"
          }
        },
        {
          "id": "as_assistant_6",
          "doc": "Reasoning reported on its own, as a thinking block. An empty one is not a thought.",
          "where": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "ThoughtEvent"
                ]
              },
              {
                "path": "$.content",
                "exists": true
              },
              {
                "path": "$.content",
                "non_empty": true
              }
            ]
          },
          "wrap": {
            "role": "assistant",
            "block": {
              "type": "thinking",
              "content_as": "text",
              "attach": [
                {
                  "value": null,
                  "after_content": true,
                  "as": "signature"
                }
              ]
            },
            "content_from": "$.content"
          }
        },
        {
          "id": "as_assistant_7",
          "doc": "The model asking for tools to run.",
          "where": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "ToolCallRequestEvent"
                ]
              },
              {
                "path": "$.content",
                "kind": "array"
              },
              {
                "path": "$.content[?@.id && @.name]",
                "exists": true
              }
            ]
          },
          "wrap": {
            "role": "assistant",
            "tool_calls_from": {
              "select": "$.content[*]",
              "id": "$.id",
              "name": "$.name",
              "arguments": "$.arguments",
              "on_invalid_item": "skip"
            },
            "attach": [
              {
                "from_value": "$.source",
                "after_content": true,
                "as": "name"
              }
            ]
          }
        },
        {
          "id": "content",
          "doc": "A batch of tool results, one message each.",
          "select": "$.content",
          "each": true,
          "lift": [
            {
              "doc": "A fact the enclosing value states once for a batch, so the element's own wins where it has one.",
              "from": "parent",
              "members": [
                "call_id"
              ],
              "on_conflict": "keep_target"
            }
          ],
          "where": {
            "any": [
              {
                "path": "$.call_id",
                "exists": true
              },
              {
                "path": "$.name",
                "exists": true
              },
              {
                "path": "$.content",
                "non_empty": true
              }
            ]
          },
          "wrap": {
            "role": "tool",
            "content_default": "",
            "attach": [
              {
                "from_value": "$.name",
                "after_content": true,
                "as": "name"
              },
              {
                "from_value": "$.call_id",
                "after_content": true,
                "as": "tool_call_id"
              }
            ],
            "content_from": "$.content"
          },
          "parent_where": {
            "all": [
              {
                "path": "$.type",
                "one_of": [
                  "ToolCallExecutionEvent",
                  "FunctionExecutionResultMessage"
                ]
              },
              {
                "path": "$.content",
                "kind": "array"
              },
              {
                "path": "$.content",
                "non_empty": true
              }
            ]
          }
        },
        {
          "id": "toolcallsummarymessage",
          "doc": "The dialect's own concatenation of tool results as Python `repr`. Claimed and read for nothing: every one of those results is reported individually, and this would repeat them as prose.",
          "where": {
            "path": "$.type",
            "one_of": [
              "ToolCallSummaryMessage"
            ]
          },
          "emit": "claim"
        },
        {
          "id": "type",
          "doc": "A type this table does not know, carrying something a reader can still use. Passed through rather than dropped: an unrecognised name is not evidence there is no message.",
          "where": {
            "all": [
              {
                "path": "$.type",
                "exists": true
              },
              {
                "any": [
                  {
                    "path": "$.role",
                    "exists": true
                  },
                  {
                    "path": "$.content",
                    "exists": true
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "type_2",
          "doc": "Untyped and already carrying a role: this is a message, not a dialect shape.",
          "where": {
            "all": [
              {
                "path": "$.type",
                "exists": false
              },
              {
                "path": "$.role",
                "exists": true
              }
            ]
          }
        },
        {
          "id": "as_assistant_8",
          "doc": "Untyped tool calls, recognised by an array whose members carry arguments.",
          "where": {
            "all": [
              {
                "path": "$.type",
                "exists": false
              },
              {
                "path": "$.content",
                "kind": "array"
              },
              {
                "path": "$.content[0].arguments",
                "exists": true
              },
              {
                "path": "$.content[?@.id && @.name]",
                "exists": true
              }
            ]
          },
          "wrap": {
            "role": "assistant",
            "tool_calls_from": {
              "select": "$.content[*]",
              "id": "$.id",
              "name": "$.name",
              "arguments": "$.arguments",
              "on_invalid_item": "skip"
            },
            "attach": [
              {
                "from_value": "$.source",
                "after_content": true,
                "as": "name"
              }
            ]
          }
        },
        {
          "id": "content_2",
          "doc": "Untyped tool results: an array whose members name a call, or name a tool and carry content without asking for one.",
          "select": "$.content",
          "each": true,
          "lift": [
            {
              "doc": "A fact the enclosing value states once for a batch, so the element's own wins where it has one.",
              "from": "parent",
              "members": [
                "call_id"
              ],
              "on_conflict": "keep_target"
            }
          ],
          "where": {
            "any": [
              {
                "path": "$.call_id",
                "exists": true
              },
              {
                "path": "$.name",
                "exists": true
              },
              {
                "path": "$.content",
                "non_empty": true
              }
            ]
          },
          "wrap": {
            "role": "tool",
            "content_default": "",
            "attach": [
              {
                "from_value": "$.name",
                "after_content": true,
                "as": "name"
              },
              {
                "from_value": "$.call_id",
                "after_content": true,
                "as": "tool_call_id"
              }
            ],
            "content_from": "$.content"
          },
          "parent_where": {
            "all": [
              {
                "path": "$.type",
                "exists": false
              },
              {
                "path": "$.content",
                "kind": "array"
              },
              {
                "any": [
                  {
                    "path": "$.content[0].call_id",
                    "exists": true
                  },
                  {
                    "path": "$.content[0].name",
                    "exists": true
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "as_assistant_9",
          "doc": "Untyped text; `source` names the speaker.",
          "where": {
            "all": [
              {
                "path": "$.type",
                "exists": false
              },
              {
                "path": "$.content",
                "kind": "string"
              },
              {
                "path": "$.content",
                "non_empty": true
              }
            ]
          },
          "wrap": {
            "role_from": {
              "path": "$.source",
              "pipe": [{"map": {"user": "user"}, "closed": true}]
            },
            "role": "assistant",
            "attach": [
              {
                "from_value": "$.source",
                "where": {
                  "none_of": [
                    "user"
                  ]
                },
                "after_content": true,
                "as": "name"
              }
            ],
            "content_from": "$.content"
          }
        }
      ]
    }
  }
}
