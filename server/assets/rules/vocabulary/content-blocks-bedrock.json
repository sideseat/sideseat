{
  "$schema": "../../rules.schema.json",
  "id": "content-blocks-bedrock",
  "doc": "The Bedrock Converse content blocks: untyped, each recognised by the one member that names it. Strands and every Converse instrumentation write them. Ranked in the order the members are tried, because a block holding two of them is read as the first.",
  "content_blocks": [
    {
      "id": "bedrock.text",
      "at": "provider_formats",
      "priority": 3000,
      "where": {
        "all": [
          {
            "path": "$",
            "only_members": [
              "text"
            ],
            "doc": "Exactly a text member. A structured output that happens to have a `text` field beside others is the producer's data, and reading it as prose would lose the rest."
          },
          {
            "path": "$.text",
            "kind": "string"
          }
        ]
      },
      "text": {
        "text": "$.text"
      }
    },
    {
      "id": "bedrock.json",
      "at": "provider_formats",
      "priority": 3010,
      "where": {
        "all": [
          {
            "path": "$",
            "only_members": [
              "json"
            ]
          },
          {
            "path": "$.json",
            "exists": true
          }
        ]
      },
      "json": {
        "data": "$.json",
        "doc": "A tool result's structured value: exactly `{\"json\": ...}`. Read as plain data, the value came back wrapped in the member that only labels it."
      }
    },
    {
      "id": "bedrock.reasoning_text",
      "at": "provider_formats",
      "priority": 3020,
      "where": {
        "path": "$.reasoningContent.reasoningText",
        "exists": true
      },
      "thinking": {
        "text": "$.reasoningContent.reasoningText.text",
        "signature": "$.reasoningContent.reasoningText.signature"
      }
    },
    {
      "id": "bedrock.reasoning_redacted",
      "at": "provider_formats",
      "priority": 3021,
      "where": {
        "path": "$.reasoningContent.redactedContent",
        "exists": true
      },
      "redacted_thinking": {
        "data": "$.reasoningContent.redactedContent.data"
      }
    },
    {
      "id": "bedrock.reasoning_other",
      "at": "provider_formats",
      "priority": 3022,
      "where": {
        "path": "$.reasoningContent",
        "exists": true
      },
      "unknown": {
        "doc": "A reasoning variant this vocabulary does not know: kept whole rather than misread, and claimed so nothing later reads it as data."
      }
    },
    {
      "id": "bedrock.image",
      "at": "provider_formats",
      "priority": 3030,
      "where": {
        "path": "$.image.source.bytes",
        "kind": "string"
      },
      "media": {
        "kind": "image",
        "data": "$.image.source.bytes",
        "media_type": {
          "path": "$.image.format",
          "prepend": "image/"
        },
        "missing_media_type": "null",
        "source": {
          "reference_or": "base64"
        },
        "doc": "Media are bytes beside a bare format name, which is the subtype under the kind's top-level type."
      }
    },
    {
      "id": "bedrock.document",
      "at": "provider_formats",
      "priority": 3031,
      "where": {
        "path": "$.document.source.bytes",
        "kind": "string"
      },
      "media": {
        "kind": "document",
        "data": "$.document.source.bytes",
        "media_type": {
          "path": "$.document.format",
          "prepend": "application/"
        },
        "missing_media_type": "null",
        "source": {
          "reference_or": "base64"
        },
        "name": "$.document.name"
      }
    },
    {
      "id": "bedrock.video",
      "at": "provider_formats",
      "priority": 3032,
      "where": {
        "path": "$.video.source.bytes",
        "kind": "string"
      },
      "media": {
        "kind": "video",
        "data": "$.video.source.bytes",
        "media_type": {
          "path": "$.video.format",
          "prepend": "video/"
        },
        "missing_media_type": "null",
        "source": {
          "reference_or": "base64"
        }
      }
    },
    {
      "id": "bedrock.tool_use",
      "at": "provider_formats",
      "priority": 3040,
      "where": {
        "path": "$.toolUse",
        "exists": true
      },
      "tool_use": {
        "id": "$.toolUse.toolUseId",
        "name": "$.toolUse.name",
        "input": "$.toolUse.input"
      }
    },
    {
      "id": "bedrock.tool_result",
      "at": "provider_formats",
      "priority": 3050,
      "where": {
        "path": "$.toolResult",
        "exists": true
      },
      "tool_result": {
        "tool_use_id": "$.toolResult.toolUseId",
        "content": "$.toolResult.content",
        "content_as": "value",
        "is_error": {
          "path": "$.toolResult.status",
          "map": {
            "error": true
          }
        },
        "doc": "The content is a list of blocks, reduced to the value it holds - the canonical form a tool-role message's content takes - so one result reads alike whether a producer wrote it as a block or as a tool message."
      }
    }
  ],
  "message_members": [
    {
      "id": "bedrock.cache_point",
      "doc": "A prompt-cache marker written as content beside the prompt it marks. It instructs the provider and says nothing in the conversation.",
      "members": [
        "cachePoint"
      ],
      "marks_control_block": true
    },
    {
      "id": "bedrock.json_wrapper",
      "doc": "A tool result's structured value, wrapped as `{\"json\": value}`: the result is the value, however it was wrapped.",
      "members": [
        "json"
      ],
      "priority": 10,
      "wraps_structured_value": true
    }
  ]
}
