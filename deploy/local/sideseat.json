{
  "$schema": "../../config/sideseat.schema.json",
  "server": {
    "host": "0.0.0.0",
    "port": 5388
  },
  "auth": {
    "enabled": false
  },
  "otel": {
    "grpc": {
      "enabled": true,
      "port": 4317
    },
    "retention": {
      "max_spans": 5000000
    }
  },
  "files": {
    "enabled": true,
    "storage": "filesystem",
    "quota_bytes": 1073741824
  },
  "rate_limit": {
    "enabled": false
  },
  "database": {
    "transactional": "postgres",
    "analytics": "clickhouse",
    "cache": "redis",
    "queue": "redpanda",
    "postgres": {
      "url": "postgres://postgres:postgres@postgres:5432/sideseat",
      "max_connections": 10
    },
    "clickhouse": {
      "url": "http://clickhouse:8123",
      "database": "sideseat",
      "timeout_secs": 30,
      "compression": true,
      "async_insert": false,
      "wait_for_async_insert": true
    },
    "redis": {
      "url": "redis://:dev_password@valkey:6379/0"
    },
    "redpanda": {
      "brokers": "redpanda:9092",
      "partitions": 6,
      "replication_factor": 1,
      "retention_ms": 604800000,
      "retention_warning_ms": 3600000
    }
  },
  "secrets": {
    "backend": "vault",
    "vault": {
      "address": "http://vault:8200",
      "token": "devroot",
      "mount": "secret",
      "prefix": "sideseat"
    }
  },
  "update": {
    "enabled": true
  },
  "debug": false
}
