{
  "name": "js-samples",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "strands": "tsx src/strands/runner.ts",
    "vercel-ai": "tsx src/vercel-ai/runner.ts",
    "claude-agent-sdk": "tsx src/claude-agent-sdk/runner.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.62",
    "@ai-sdk/otel": "^1.0.79",
    "@anthropic-ai/claude-agent-sdk": "^0.3.246",
    "@aws-sdk/client-bedrock-runtime": "^3.1118.0",
    "@aws-sdk/client-s3": "^3.1118.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/instrumentation-aws-sdk": "^0.76.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sideseat/sdk": "file:../../../sdk/js",
    "@strands-agents/sdk": "^1.14.0",
    "ai": "^7.0.79",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "//opentelemetry": "exporter-trace-otlp-http is held at 0.219 because @strands-agents/sdk 1.14 declares peerOptional ^0.219.0, and 0.x minors are breaking under semver so 0.221 does not satisfy it. sdk/js itself is on 0.221; npm nests the two. Revisit when Strands widens that peer range.",
  "//typescript": "Held at 5.x to match sdk/js, which cannot move to TypeScript 7 until tsup's rollup-plugin-dts supports it."
}
