#!/usr/bin/env bash
#
# Cheap by design: a commit must never wait for a test suite. This hook stops the two mistakes that
# are expensive to undo once committed - a secret, and an oversized file - and checks formatting.
# Lint and tests run in `make quick` while iterating, in the pre-push hook, and in CI.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# A committed secret survives in reflogs, stashes, and clones even if it is never pushed.
make --no-print-directory secret-scan-staged
# Reads blobs from the index, so an unstaged shortening cannot hide an oversized staged version.
./scripts/check/file-lengths.sh --cached

staged() { git diff --cached --name-only --diff-filter=ACMR -- "$@"; }

if [ -n "$(staged '*.rs')" ]; then
    cargo fmt --all -- --check
fi

python_files="$(staged '*.py')"
if [ -n "$python_files" ]; then
    # shellcheck disable=SC2086
    uv run --locked ruff format --check $python_files
fi

for project in web sdk/js examples/javascript; do
    files="$(staged "$project/*.ts" "$project/*.tsx" "$project/*.css" "$project/*.json")"
    [ -n "$files" ] || continue
    [ -x "$project/node_modules/.bin/prettier" ] || { echo "Error: $project/node_modules missing. Run 'make setup'."; exit 1; }
    # From the project, as `make quick` runs it, so the project's .prettierignore applies: generated
    # JSON such as capture cassettes is not the project's to format.
    # shellcheck disable=SC2046,SC2086
    (cd "$project" && node_modules/.bin/prettier --check $(sed "s#^$project/##" <<<"$files"))
done

echo "[pre-commit] Passed"
