#!/usr/bin/env bash
#
# Delegates to the Makefile rather than restating its commands. The previous version inlined
# per-area checks, which drifted from `make` and covered neither misc/samples/js nor
# misc/samples/python.
#
# Scoped by staged area on purpose: this runs on every commit, so it does the cheap checks
# (format, lint) plus the tests for the areas actually touched. `make check` in the pre-push
# hook is the complete gate.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

staged() { git diff --cached --name-only -- "$@" | grep -qc . 2>/dev/null; }

# A secret that reaches a commit is effectively public even if it is never pushed: it survives
# in reflogs, stashes and any clone, and removing it needs a history rewrite. Cheapest possible
# place to stop it, so it runs first and unconditionally.
make secret-scan-staged

RUST=0; WEB=0; JS_SDK=0; PY=0
staged 'server/' 'sdk/rust/' && RUST=1
staged 'web/'                && WEB=1
staged 'sdk/js/'             && JS_SDK=1
staged 'sdk/python/' 'misc/samples/python/' && PY=1

if [ "$RUST$WEB$JS_SDK$PY" = "0000" ]; then
    echo "[pre-commit] No code staged, skipping build checks"
    echo "[pre-commit] All checks passed"
    exit 0
fi

# Format and lint are whole-tree and fast, and they are what most commits get wrong.
echo "[pre-commit] Format + lint..."
make fmt-check
make lint

# Tests only for the areas touched: the full suite belongs in pre-push.
[ "$RUST" = 1 ]   && { echo "[pre-commit] Rust tests...";       make test-server; }
[ "$WEB" = 1 ]    && { echo "[pre-commit] Web tests...";        make test-web; }
[ "$JS_SDK" = 1 ] && { echo "[pre-commit] JS SDK tests...";     make test-sdk-js; }
[ "$PY" = 1 ]     && { echo "[pre-commit] Python SDK tests..."; make test-sdk-python; }

echo "[pre-commit] All checks passed"
