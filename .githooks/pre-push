#!/usr/bin/env bash
#
# Delegates to the Makefile rather than restating its commands.
#
# It used to inline every check, and the copy had drifted into a weaker version of the real
# gate: it never checked misc/samples/js or misc/samples/python at all, and its clippy ran
# from server/ so it scoped to that package and skipped sdk/rust. Sample and SDK code could
# therefore be pushed unformatted and unlinted by a hook that looked thorough.
#
# `make check` is fmt-check + lint + test across every area. Keep it that way: one definition,
# and `make check` locally means the same thing the hook enforces.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "[pre-push] make check + secret scan..."

# Prerequisites the make targets assume. Checked here because the failure is far clearer than
# whatever npx or uv would print.
for dir in web sdk/js misc/samples/js; do
    if [ ! -d "$REPO_ROOT/$dir/node_modules" ]; then
        echo "Error: $dir/node_modules missing. Run 'make setup' first."
        exit 1
    fi
done
if ! command -v uv >/dev/null 2>&1; then
    echo "Error: uv not found. Install with: curl -LsSf https://astral.sh/uv/install.sh | sh"
    exit 1
fi

make check

# Last gate before anything becomes public: pre-commit can be bypassed with --no-verify, and a
# rebuilt or rebased series can reintroduce content that was scrubbed.
make secret-scan-range

echo "[pre-push] All checks passed"
