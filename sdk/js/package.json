{
  "name": "@sideseat/sdk",
  "version": "2.0.0",
  "description": "SideSeat SDK for AI observability",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "lint": "eslint src",
    "fmt": "prettier --write src"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "sideseat",
    "opentelemetry",
    "observability",
    "ai",
    "llm",
    "agents"
  ],
  "license": "MIT",
  "homepage": "https://sideseat.ai",
  "bugs": {
    "url": "https://github.com/sideseat/sideseat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sideseat/sideseat.git"
  },
  "engines": {
    "node": ">=18"
  },
  "//typescript": "Pinned to 5.x: TypeScript 7 breaks `npm run build` because tsup's bundled rollup-plugin-dts resolves typescript 5.7.3 internally and throws 'Cannot read properties of undefined (reading useCaseSensitiveFileNames)', so no .d.ts is emitted. Revisit once tsup supports TS 7."
}
